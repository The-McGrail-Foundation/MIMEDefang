#!@PERL@

#***********************************************************************
#
# mimedefang-dashboard
#
# Live web console for the MIMEDefang mail flow.  It runs its own HTTP
# server and keeps everything in memory: events arrive on a UNIX
# datagram socket fed by md_graphdefang_log() (see
# md_graphdefang_feed_enable) and worker statistics are polled from the
# multiplexor control socket.  It never reads the mail log and refuses
# to run as root.
#
# * This program may be distributed under the terms of the GNU General
# * Public License, Version 2.
#
#***********************************************************************

package main;

use strict;
use warnings;

use Encode qw(decode);
use Errno qw(EAGAIN EWOULDBLOCK EINTR);
use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
use File::Basename qw(dirname);
use Getopt::Long;
use IO::Select;
use MIME::Base64 ();
use IO::Socket::IP;
use IO::Socket::UNIX;
use POSIX qw(floor setsid);
use Pod::Usage;
use Socket qw(SOCK_DGRAM SOCK_STREAM PF_UNIX pack_sockaddr_un);
use Time::HiRes qw(time);

use Mail::MIMEDefang ();

our $VERSION = '@VERSION@';
my $DEFANGUSER = '@DEFANGUSER@';

my $JSON_CLASS;
BEGIN {
  for my $c (qw(Cpanel::JSON::XS JSON::XS JSON::PP)) {
    if (eval "require $c; 1") { ## no critic (BuiltinFunctions::ProhibitStringyEval)
      $JSON_CLASS = $c;
      last;
    }
  }
}
my $JSON = $JSON_CLASS->new->utf8->canonical(1)->allow_nonref(1);

our %Opt = (
  listen         => '127.0.0.1:8689',
  'mx-socket'    => '@SPOOLDIR@/mimedefang-multiplexor.sock',
  feed           => '@SPOOLDIR@/mimedefang-dashboard.sock',
  'feed-mode'    => '0660',
  interval       => 2,
  history        => 5000,
  'state-interval' => 300,
  stale          => 900,
  'spam-event'   => 'spam',
  'ml-events'    => 'ml_spam,ml_not_spam,ml_phishing,ml_not_phishing,ml_unsure',
  events         => 'mail_out,spam,mail_in',
  'top-cap'      => 300,
);

#***********************************************************************
# MDLOG parsing
#***********************************************************************

my $ADDR_RE  = qr/^(?:[^\s,]*\@[^\s,]*|<[^>]*>|)$/;
my $RCPT_RE  = qr/^(?:rcpts=\d+|[^\s,]*\@[^\s,]*|<[^>]*>|)$/;

sub pct_decode {
  my ($s) = @_;
  return '' unless defined $s;
  return decode('UTF-8', Mail::MIMEDefang::percent_decode($s));
}

# RFC 2047 encoded-words (=?UTF-8?B?...?=), as logged when the filter
# does not decode the subject itself
sub mime_decode {
  my ($s) = @_;
  return $s unless defined $s && $s =~ /=\?[^?\s]+\?[BbQq]\?/;
  my $d = eval { decode('MIME-Header', $s) };
  return defined $d ? $d : $s;
}

sub addr_domain {
  my ($a) = @_;
  return '' unless defined $a && $a =~ /\@([^\@>\s]+)>?$/;
  return lc $1;
}

#***********************************************************************
# %PROCEDURE: parse_mdlog
# %ARGUMENTS:
#  line -- an MDLOG line, optionally preceded by a syslog prefix
#  now -- arrival time
# %RETURNS:
#  A hashref describing the event, or undef if the line is not MDLOG.
# %DESCRIPTION:
#  The format is MDLOG,id,event,value...,sender,recipient,subject.
#  Fields are percent-encoded so commas cannot appear inside them,
#  except when md_graphdefang_log was asked to decode UTF-8, in which
#  case the subject (last) and the values may contain commas.  The
#  common case is tried first; otherwise the sender/recipient pair is
#  located by shape.
#***********************************************************************
sub parse_mdlog {
  my ($line, $now) = @_;
  return unless defined $line;
  my $i = index($line, 'MDLOG,');
  return if $i < 0;
  $line = substr($line, $i);
  $line =~ s/[\r\n]+\z//;
  my @f = split /,/, $line, -1;
  return if @f < 6;
  shift @f;
  my $id = shift @f;
  my $event = shift @f;
  return if !defined $event || $event eq '';

  my ($sender, $rcpt, $subject, @values);
  if ($f[-3] =~ $ADDR_RE && $f[-2] =~ $RCPT_RE) {
    ($sender, $rcpt, $subject) = @f[-3, -2, -1];
    @values = @f[0 .. $#f - 3];
  } else {
    # Prefer a pair of non-empty fields: values are often empty
    my $k;
    for my $nonempty (1, 0) {
      for my $j (1 .. $#f - 1) {
        next if $nonempty && ($f[$j - 1] eq '' || $f[$j] eq '');
        if ($f[$j - 1] =~ $ADDR_RE && $f[$j] =~ $RCPT_RE) {
          $k = $j;
          last;
        }
      }
      last if defined $k;
    }
    return unless defined $k;
    $sender = $f[$k - 1];
    $rcpt = $f[$k];
    $subject = join(',', @f[$k + 1 .. $#f]);
    @values = @f[0 .. $k - 2];
  }

  my %ev = (
    t       => 0 + sprintf('%.3f', $now),
    id      => pct_decode($id),
    event   => pct_decode($event),
    values  => [ map { pct_decode($_) } @values ],
    sender  => pct_decode($sender),
    subject => mime_decode(pct_decode($subject)),
  );
  my $r = pct_decode($rcpt);
  if ($r =~ /^rcpts=(\d+)$/) {
    $ev{rcpt} = '';
    $ev{rcpts} = $1 + 0;
  } else {
    $ev{rcpt} = $r;
    $ev{rcpts} = 1;
  }
  return \%ev;
}

sub anonymize_event {
  my ($ev) = @_;
  for my $k (qw(sender rcpt)) {
    next unless $ev->{$k} =~ /^(<?)([^\@]*)\@(.*)$/;
    my $l = $2;
    $ev->{$k} = $1 . (length($l) ? substr($l, 0, 1) . '***' : '') . '@' . $3;
  }
  $ev->{subject} = '';
  return $ev;
}

#***********************************************************************
# In-memory store
#***********************************************************************

package MDDash::Store; ## no critic (Modules::ProhibitMultiplePackages)

use POSIX qw(floor);

use constant {
  MIN_KEEP   => 24 * 3600,
  HOUR_KEEP  => 30 * 24 * 3600,
  SLICE5     => 300,
  TOP5_KEEP  => 3600,
  TOPH_KEEP  => 24 * 3600,
  SCORE_KEEP => 7 * 24 * 3600,
  SLOTS      => 7,     # categorical slots; later events fold into "other"
  STATE_VER  => 1,
};

my @DIMS = qw(sender sender_domain rcpt rcpt_domain value1 value2);

sub new {
  my ($class, %o) = @_;
  my $self = bless {
    history   => $o{history} || 5000,
    top_cap   => $o{top_cap} || 300,
    spam_event => $o{spam_event} // 'spam',
    ml_events => { map { $_ => 1 } @{ $o{ml_events} || [] } },
    recent    => [],
    min       => {},
    hour      => {},
    top5      => {},
    toph      => {},
    score     => {},
    totals    => {},
    slots     => {},
    nslots    => 0,
    feed_count => 0,
    feed_errors => 0,
    last_event => undef,
    mx        => undef,
    mx_prev_msgs => undef,
    started   => $o{now} // time(),
  }, $class;
  $self->slot($_) for @{ $o{pinned} || [] };
  return $self;
}

# Stable color slot per event name: first come, first served.
sub slot {
  my ($self, $ev) = @_;
  return $self->{slots}{$ev} if exists $self->{slots}{$ev};
  return $self->{slots}{$ev} = ++$self->{nslots};
}

sub _bucket {
  my ($h, $t) = @_;
  return $h->{$t} //= { ev => {}, mxn => 0, busy => 0, ams => 0, amsn => 0, msgs => 0, queued => 0 };
}

sub add_event {
  my ($self, $ev) = @_;
  my $t = $ev->{t};
  my $name = $ev->{event};
  $self->slot($name);

  push @{ $self->{recent} }, $ev;
  splice(@{ $self->{recent} }, 0, @{ $self->{recent} } - $self->{history})
    if @{ $self->{recent} } > $self->{history};

  $self->{totals}{$name}++;
  $self->{feed_count}++;
  $self->{last_event} = $t;

  _bucket($self->{min}, 60 * floor($t / 60))->{ev}{$name}++;
  _bucket($self->{hour}, 3600 * floor($t / 3600))->{ev}{$name}++;

  my %keys = (
    sender        => $ev->{sender},
    sender_domain => main::addr_domain($ev->{sender}),
    rcpt          => $ev->{rcpt},
    rcpt_domain   => main::addr_domain($ev->{rcpt}),
    value1        => $ev->{values}[0],
    value2        => $ev->{values}[1],
  );
  for my $slices ([ $self->{top5}, SLICE5 * floor($t / SLICE5) ],
                  [ $self->{toph}, 3600 * floor($t / 3600) ]) {
    my $s = $slices->[0]{ $slices->[1] } //= {};
    for my $d (@DIMS) {
      my $k = $keys{$d};
      next if !defined $k || $k eq '';
      for my $e ($name, '*') {
        my $h = $s->{$d}{$e} //= {};
        $h->{$k}++;
        _trim($h, $self->{top_cap}) if keys(%$h) > 2 * $self->{top_cap};
      }
    }
  }

  my $v = $ev->{values}[0];
  if (defined $v && $v =~ /^\s*(-?\d+(?:\.\d+)?)\s*$/) {
    my $x = $1;
    my $bin;
    if ($name eq $self->{spam_event}) {
      $bin = floor($x);
      $bin = -10 if $bin < -10;
      $bin = 50 if $bin > 50;
    } elsif ($self->{ml_events}{$name}) {
      $x /= 100 if $x > 1;
      $x = 0 if $x < 0;
      $bin = floor($x * 10) / 10;
      $bin = 0.9 if $bin > 0.9;
    }
    $self->{score}{ 3600 * floor($t / 3600) }{$name}{$bin}++ if defined $bin;
  }
  return;
}

# Approximate top-N: keep the largest entries when a counter grows too big
sub _trim {
  my ($h, $cap) = @_;
  my @k = sort { $h->{$b} <=> $h->{$a} } keys %$h;
  delete @{$h}{ @k[$cap .. $#k] };
  return;
}

sub add_mx_sample {
  my ($self, $snap, $t) = @_;
  $self->{mx} = $snap;
  $self->{mx_time} = $t;
  my $msgs = $snap->{msgs} // 0;
  my $delta = 0;
  if (defined $self->{mx_prev_msgs}) {
    $delta = $msgs - $self->{mx_prev_msgs};
    $delta = $msgs if $delta < 0;    # multiplexor restarted
  }
  $self->{mx_prev_msgs} = $msgs;
  my $busy = $snap->{worker_states}{busy} // 0;
  my $queued = $snap->{queued} // 0;
  my $load = $snap->{load}{scan} || {};
  for my $b (_bucket($self->{min}, 60 * floor($t / 60)),
             _bucket($self->{hour}, 3600 * floor($t / 3600))) {
    $b->{mxn}++;
    $b->{busy} += $busy;
    $b->{msgs} += $delta;
    $b->{queued} = $queued if $queued > $b->{queued};
    if (($load->{msgs_0} // 0) > 0) {
      $b->{ams} += $load->{ams_0};
      $b->{amsn}++;
    }
  }
  return;
}

sub prune {
  my ($self, $now) = @_;
  for ([ min => MIN_KEEP ], [ hour => HOUR_KEEP ], [ top5 => TOP5_KEEP + SLICE5 ],
       [ toph => TOPH_KEEP + 3600 ], [ score => SCORE_KEEP + 3600 ]) {
    my ($k, $keep) = @$_;
    my $h = $self->{$k};
    delete @{$h}{ grep { $_ < $now - $keep } keys %$h };
  }
  return;
}

# Names of known events, ordered by slot
sub event_names {
  my ($self) = @_;
  my $s = $self->{slots};
  my @names = sort { $s->{$a} <=> $s->{$b} } keys %$s;
  return @names;
}

my %RANGES = (
  '1h'  => [ 'min',  3600,           60 ],
  '6h'  => [ 'min',  6 * 3600,       300 ],
  '24h' => [ 'min',  24 * 3600,      600 ],
  '7d'  => [ 'hour', 7 * 24 * 3600,  3600 ],
  '30d' => [ 'hour', 30 * 24 * 3600, 4 * 3600 ],
);

sub series {
  my ($self, $range, $now) = @_;
  my $r = $RANGES{$range // ''} || $RANGES{'1h'};
  my ($src, $span, $step) = @$r;
  my $unit = $src eq 'min' ? 60 : 3600;
  my $end = $step * floor($now / $step) + $step;
  my $start = $end - $span;
  my $n = int($span / $step);
  my %ev;
  my (@msgs, @busy, @ams, @queued, @mxn, @amsn);
  @$_ = (0) x $n for (\@msgs, \@busy, \@ams, \@queued, \@mxn, \@amsn);
  my $h = $self->{$src};
  for (my $t = $start - ($start % $unit); $t < $end; $t += $unit) {
    my $b = $h->{$t} or next;
    my $i = int(($t - $start) / $step);
    next if $i < 0 || $i >= $n;
    while (my ($e, $c) = each %{ $b->{ev} }) {
      ($ev{$e} //= [ (0) x $n ])->[$i] += $c;
    }
    $msgs[$i] += $b->{msgs};
    $busy[$i] += $b->{busy};
    $mxn[$i] += $b->{mxn};
    $ams[$i] += $b->{ams};
    $amsn[$i] += $b->{amsn};
    $queued[$i] = $b->{queued} if $b->{queued} > $queued[$i];
  }
  for my $i (0 .. $n - 1) {
    $busy[$i] = $mxn[$i] ? 0 + sprintf('%.2f', $busy[$i] / $mxn[$i]) : undef;
    $ams[$i] = $amsn[$i] ? 0 + sprintf('%.1f', $ams[$i] / $amsn[$i]) : undef;
    $msgs[$i] = undef unless $mxn[$i];
  }
  return {
    range => (exists $RANGES{$range // ''} ? $range : '1h'),
    start => $start, step => $step, n => $n,
    events => [ grep { exists $ev{$_} } $self->event_names ],
    ev => \%ev,
    mx => { msgs => \@msgs, busy => \@busy, ams => \@ams, queued => \@queued },
  };
}

sub totals_window {
  my ($self, $secs, $now) = @_;
  my %c;
  my $from = $now - $secs;
  my ($src, $unit) = $secs <= MIN_KEEP ? ($self->{min}, 60) : ($self->{hour}, 3600);
  while (my ($t, $b) = each %$src) {
    next if $t + $unit <= $from;
    $c{$_} += $b->{ev}{$_} for keys %{ $b->{ev} };
  }
  return \%c;
}

sub top {
  my ($self, %q) = @_;
  my $dim = $q{dim} // 'sender_domain';
  return { error => "unknown dimension" } unless grep { $_ eq $dim } @DIMS;
  my $event = defined $q{event} && $q{event} ne '' ? $q{event} : '*';
  my $n = $q{n} && $q{n} =~ /^\d+$/ ? ($q{n} > 200 ? 200 : $q{n}) : 20;
  my $day = ($q{window} // '1h') eq '24h';
  my ($slices, $from, $len) = $day ? ($self->{toph}, $q{now} - TOPH_KEEP, 3600)
                                   : ($self->{top5}, $q{now} - TOP5_KEEP, SLICE5);
  my %sum;
  while (my ($t, $s) = each %$slices) {
    next if $t + $len <= $from;
    my $h = $s->{$dim}{$event} or next;
    $sum{$_} += $h->{$_} for keys %$h;
  }
  my @k = sort { $sum{$b} <=> $sum{$a} || $a cmp $b } keys %sum;
  splice(@k, $n) if @k > $n;
  return {
    dim => $dim, event => $event, window => ($day ? '24h' : '1h'),
    items => [ map { { key => $_, count => $sum{$_} } } @k ],
  };
}

sub scores {
  my ($self, $window, $now) = @_;
  my $secs = ($window // '24h') eq '7d' ? 7 * 24 * 3600 : 24 * 3600;
  my %out;
  while (my ($t, $s) = each %{ $self->{score} }) {
    next if $t + 3600 <= $now - $secs;
    for my $e (keys %$s) {
      $out{$e}{$_} += $s->{$e}{$_} for keys %{ $s->{$e} };
    }
  }
  my %res;
  for my $e (keys %out) {
    my $bins = $out{$e};
    $res{$e} = [ map { { bin => 0 + $_, count => $bins->{$_} } }
                 sort { $a <=> $b } keys %$bins ];
  }
  return {
    window => ($secs > 24 * 3600 ? '7d' : '24h'),
    spam_event => $self->{spam_event},
    ml_events => [ sort keys %{ $self->{ml_events} } ],
    scores => \%res,
  };
}

sub events {
  my ($self, %q) = @_;
  my $limit = $q{limit} && $q{limit} =~ /^\d+$/ ? $q{limit} : 200;
  $limit = 1000 if $limit > 1000;
  my $re;
  if (defined $q{q} && $q{q} ne '') {
    $re = qr/\Q$q{q}\E/i;
  }
  my @out;
  for (my $i = $#{ $self->{recent} }; $i >= 0 && @out < $limit; $i--) {
    my $ev = $self->{recent}[$i];
    next if defined $q{event} && $q{event} ne '' && $ev->{event} ne $q{event};
    next if defined $q{id} && $q{id} ne '' && $ev->{id} ne $q{id};
    next if $re && join("\0", $ev->{id}, $ev->{event}, @{ $ev->{values} },
                        $ev->{sender}, $ev->{rcpt}, $ev->{subject}) !~ $re;
    push @out, $ev;
  }
  return { events => \@out, total => scalar @{ $self->{recent} } };
}

sub to_state {
  my ($self) = @_;
  return {
    version => STATE_VER,
    last_event => $self->{last_event},
    map { $_ => $self->{$_} } qw(min hour top5 toph score totals slots nslots),
  };
}

sub from_state {
  my ($self, $st) = @_;
  return 0 unless ref $st eq 'HASH' && ($st->{version} // 0) == STATE_VER;
  for my $k (qw(min hour top5 toph score totals slots)) {
    $self->{$k} = $st->{$k} if ref $st->{$k} eq 'HASH';
  }
  $self->{last_event} = $st->{last_event} if defined $st->{last_event};
  # Slots pinned on the command line keep their position
  my $n = 0;
  for my $v (values %{ $self->{slots} }) {
    $n = $v if $v > $n;
  }
  $self->{nslots} = $n;
  return 1;
}

package main; ## no critic (Modules::ProhibitMultiplePackages)

#***********************************************************************
# Multiplexor client
#***********************************************************************

#***********************************************************************
# %PROCEDURE: mx_command
# %ARGUMENTS:
#  path -- multiplexor control socket
#  cmd -- command (without newline)
#  timeout -- seconds
# %RETURNS:
#  The answer, or undef with $@ set.
# %DESCRIPTION:
#  Same protocol as md-mx-ctrl: write "cmd\n", read until EOF.
#***********************************************************************
sub mx_command {
  my ($path, $cmd, $timeout) = @_;
  $timeout ||= 2;
  my $s = IO::Socket::UNIX->new(Peer => $path, Type => SOCK_STREAM, Timeout => $timeout);
  if (!$s) {
    $@ = "connect $path: $!";
    return;
  }
  my $deadline = time() + $timeout;
  if (!defined syswrite($s, "$cmd\n")) {
    $@ = "write: $!";
    return;
  }
  my $sel = IO::Select->new($s);
  my $ans = '';
  while (1) {
    my $left = $deadline - time();
    if ($left <= 0 || !$sel->can_read($left)) {
      $@ = 'timeout';
      return;
    }
    my $n = sysread($s, my $buf, 65536);
    if (!defined $n) {
      next if $! == EINTR;
      $@ = "read: $!";
      return;
    }
    last if $n == 0;
    $ans .= $buf;
  }
  close $s;
  return $ans;
}

# Build a snapshot from the text commands of an older multiplexor
sub mx_legacy_snapshot {
  my ($path) = @_;
  my $status = mx_command($path, 'status') // return;
  my $load = mx_command($path, 'load') // return;
  my ($states, $msgs, $act, $qsize, $queued, $uptime) = split ' ', $status;
  return if !defined $uptime || $states !~ /^[IBSK?]+$/;
  my @l = split ' ', $load;
  my %cnt = (busy => 0, idle => 0, stopped => 0, killed => 0);
  my %name = (B => 'busy', I => 'idle', S => 'stopped', K => 'killed');
  my @workers;
  my $i = 0;
  for my $c (split //, $states) {
    my $st = $name{$c} // 'unknown';
    $cnt{$st}++;
    push @workers, { id => $i++, state => $st };
  }
  my %scan;
  my @sfx = qw(0 1 5 10);
  my @secs = (10, 60, 300, 600);
  for my $j (0 .. 3) {
    $scan{"msgs_$sfx[$j]"} = 0 + ($l[$j] // 0);
    $scan{"avg_$sfx[$j]"} = 0 + ($l[4 + $j] // 0);
    $scan{"ams_$sfx[$j]"} = 0 + ($l[8 + $j] // 0);
    $scan{"mps_$sfx[$j]"} = 0 + sprintf('%.2f', ($l[$j] // 0) / $secs[$j]);
  }
  my @histo;
  if (defined(my $h = mx_command($path, 'histo'))) {
    for (split /\n/, $h) {
      push @histo, 0 + $2 if /^\s*(\d+)\s+(\d+)/;
    }
  }
  return {
    legacy => 1, time => int(time()), uptime => 0 + $uptime, msgs => 0 + $msgs,
    activations => 0 + $act, queue_size => 0 + $qsize, queued => 0 + $queued,
    worker_states => { %cnt, max => length($states) },
    load => { scan => \%scan }, histo => \@histo, workers => \@workers,
  };
}

sub mx_snapshot {
  my ($path) = @_;
  my $ans = mx_command($path, 'jsonsnapshot');
  return (undef, $@) unless defined $ans;
  if ($ans =~ /^\s*\{/) {
    my $snap = eval { $JSON->decode($ans) };
    return ($snap, undef) if ref $snap eq 'HASH';
    return (undef, "invalid JSON from multiplexor: $@");
  }
  # Older multiplexor: the command reached a Perl worker instead
  my $snap = mx_legacy_snapshot($path);
  return ($snap, undef) if $snap;
  return (undef, $@ || 'unexpected answer from multiplexor');
}

#***********************************************************************
# Application
#***********************************************************************

package MDDash::App; ## no critic (Modules::ProhibitMultiplePackages)

use Errno qw(EAGAIN EWOULDBLOCK EINTR);
use POSIX qw(floor);
use Socket qw(SOCK_DGRAM PF_UNIX pack_sockaddr_un);

use constant {
  MAX_REQ       => 16384,
  REQ_TIMEOUT   => 15,
  MAX_CLIENTS   => 64,
  MAX_SSE       => 32,
  MAX_OUTBUF    => 4 * 1024 * 1024,
  SSE_HEARTBEAT => 20,
};

sub new {
  my ($class, %opt) = @_;
  my $now = main::time();
  my @ml = grep { length } split /\s*,\s*/, ($opt{'ml-events'} // '');
  my $self = bless {
    opt     => \%opt,
    store   => MDDash::Store->new(
      history => $opt{history}, top_cap => $opt{'top-cap'},
      spam_event => $opt{'spam-event'}, ml_events => \@ml,
      pinned => [ grep { length } split /\s*,\s*/, ($opt{events} // '') ],
      now => $now,
    ),
    sel     => IO::Select->new,
    clients => {},
    pending => [],
    started => $now,
    mx_error => undef,
    mx_enabled => ($opt{'mx-socket'} // 'none') ne 'none',
    feed_enabled => ($opt{feed} // 'none') ne 'none',
    assets  => main::load_assets(),
  }, $class;
  return $self;
}

sub log_msg {
  my ($self, $msg) = @_;
  return if $self->{opt}{quiet};
  if (defined $self->{opt}{syslog}) {
    Mail::MIMEDefang::md_syslog('info', $msg);
    return;
  }
  my @t = localtime();
  printf STDERR "%04d-%02d-%02d %02d:%02d:%02d mimedefang-dashboard: %s\n",
    $t[5] + 1900, $t[4] + 1, @t[3, 2, 1, 0], $msg;
  return;
}

sub nonblock {
  my ($fh) = @_;
  my $fl = fcntl($fh, Fcntl::F_GETFL(), 0);
  fcntl($fh, Fcntl::F_SETFL(), $fl | Fcntl::O_NONBLOCK()) if defined $fl;
  return;
}

#***********************************************************************
# %PROCEDURE: open_feed
# %DESCRIPTION:
#  Binds the datagram socket the filter writes to.  A stale socket file
#  is removed, but not one another running dashboard is bound to.
#***********************************************************************
sub open_feed {
  my ($self) = @_;
  my $path = $self->{opt}{feed};
  if (-S $path) {
    socket(my $probe, PF_UNIX, SOCK_DGRAM, 0) or die "socket: $!\n";
    if (connect($probe, pack_sockaddr_un($path))) {
      die "Another process is bound to $path\n";
    }
    unlink $path or die "Cannot remove stale $path: $!\n";
  } elsif (-e $path) {
    die "$path exists and is not a socket\n";
  }
  socket(my $s, PF_UNIX, SOCK_DGRAM, 0) or die "socket: $!\n";
  my $old = umask(0177);
  my $ok = bind($s, pack_sockaddr_un($path));
  umask($old);
  die "Cannot bind $path: $!\n" unless $ok;
  chmod(oct($self->{opt}{'feed-mode'}), $path)
    or die "Cannot chmod $path: $!\n";
  nonblock($s);
  $self->{feed} = $s;
  $self->{feed_path} = $path;
  $self->{sel}->add($s);
  $self->log_msg("receiving events on $path");
  return;
}

sub open_listen {
  my ($self) = @_;
  my $l = $self->{opt}{listen};
  my ($host, $port) = $l =~ /^\[([^\]]+)\]:(\d+)$/ ? ($1, $2)
                    : $l =~ /^([^:]*):(\d+)$/       ? ($1, $2)
                    : $l =~ /^(\d+)$/               ? ('127.0.0.1', $1)
                    : die "Invalid --listen value '$l'\n";
  $host = '127.0.0.1' if $host eq '';
  my $s = IO::Socket::IP->new(
    LocalHost => $host, LocalPort => $port, Listen => 64, ReuseAddr => 1,
    Proto => 'tcp',
  ) or die "Cannot listen on $l: $@\n";
  nonblock($s);
  $self->{listen} = $s;
  $self->{port} = $s->sockport;
  $self->{loopback} = ($host =~ /^(?:127\.|::1$|localhost$)/) ? 1 : 0;
  $self->{sel}->add($s);
  $self->log_msg("listening on http://" . ($host =~ /:/ ? "[$host]" : $host) . ":$self->{port}/");
  return;
}

sub load_state {
  my ($self) = @_;
  my $f = $self->{opt}{state} or return;
  return unless -e $f;
  my $st = eval {
    open(my $fh, '<:raw', $f) or die "$!\n";
    local $/;
    my $data = <$fh>;
    close $fh;
    $JSON->decode($data);
  };
  if (!$st || !$self->{store}->from_state($st)) {
    $self->log_msg("ignoring state file $f: " . ($@ || 'unknown format'));
    return;
  }
  $self->log_msg("loaded state from $f");
  return;
}

sub save_state {
  my ($self) = @_;
  my $f = $self->{opt}{state} or return;
  my $tmp = "$f.tmp.$$";
  my $old = umask(077);    # the state contains addresses
  my $ok = eval {
    open(my $fh, '>:raw', $tmp) or die "$!\n";
    print {$fh} $JSON->encode($self->{store}->to_state) or die "$!\n";
    close $fh or die "$!\n";
    rename($tmp, $f) or die "$!\n";
    1;
  };
  umask($old);
  if (!$ok) {
    unlink $tmp;
    $self->log_msg("cannot save state to $f: $@");
  }
  return;
}

sub poll_mx {
  my ($self) = @_;
  return unless $self->{mx_enabled};
  my ($snap, $err) = main::mx_snapshot($self->{opt}{'mx-socket'});
  if ($snap) {
    $self->log_msg('multiplexor reachable') if $self->{mx_error};
    $self->{mx_error} = undef;
    $self->{store}->add_mx_sample($snap, main::time());
  } else {
    $self->log_msg("multiplexor: $err")
      if !defined $self->{mx_error} || $self->{mx_error} ne $err;
    $self->{mx_error} = $err;
    $self->{store}{mx} = undef;
  }
  return;
}

sub drain_feed {
  my ($self) = @_;
  my $s = $self->{feed} or return;
  my $store = $self->{store};
  for (1 .. 5000) {
    my $from = recv($s, my $buf, 65536, 0);
    last unless defined $from;
    my $ev = main::parse_mdlog($buf, main::time());
    if (!$ev) {
      $store->{feed_errors}++;
      next;
    }
    main::anonymize_event($ev) if $self->{opt}{anonymize};
    $store->add_event($ev);
    push @{ $self->{pending} }, $ev;
  }
  return;
}

#***********************************************************************
# Summary, alerts and metrics
#***********************************************************************

sub summary {
  my ($self, $lite) = @_;
  my $now = main::time();
  my $st = $self->{store};
  my $mx = $st->{mx};
  my %s = (
    now => int($now),
    version => $VERSION,
    uptime => int($now - $self->{started}),
    mx => {
      enabled => $self->{mx_enabled} ? \1 : \0,
      up => $mx ? \1 : \0,
      error => $self->{mx_error},
      legacy => ($mx && $mx->{legacy}) ? \1 : \0,
    },
    feed => {
      enabled => $self->{feed_enabled} ? \1 : \0,
      path => $self->{feed_path},
      received => $st->{feed_count},
      errors => $st->{feed_errors},
      last_event_age => defined $st->{last_event} ? int($now - $st->{last_event}) : undef,
    },
    slots => $st->{slots},
    alerts => $self->alerts($now),
  );
  if ($mx) {
    $s{mx}{$_} = $mx->{$_} for qw(version uptime msgs activations queue_size queued worker_states);
    $s{mx}{load} = $mx->{load}{scan};
  }
  if (!$lite) {
    $s{events_1h} = $st->totals_window(3600, $now);
    $s{events_24h} = $st->totals_window(24 * 3600, $now);
    $s{config} = {
      anonymize => $self->{opt}{anonymize} ? \1 : \0,
      interval => $self->{opt}{interval},
      spam_event => $self->{opt}{'spam-event'},
      ml_events => [ sort keys %{ $st->{ml_events} } ],
    };
  }
  return \%s;
}

sub alerts {
  my ($self, $now) = @_;
  my $st = $self->{store};
  my $mx = $st->{mx};
  my @a;
  if ($self->{mx_enabled} && !$mx) {
    push @a, { level => 'critical', text => "Multiplexor unreachable: " . ($self->{mx_error} // 'no answer yet') };
  }
  if ($mx) {
    my $ws = $mx->{worker_states} || {};
    if (($mx->{queued} // 0) > 0) {
      push @a, { level => 'warning', text => "$mx->{queued} request(s) waiting in the multiplexor queue" };
    }
    if (($ws->{max} // 0) > 0 && ($ws->{busy} // 0) >= $ws->{max}) {
      push @a, { level => 'serious', text => "All $ws->{max} workers are busy" };
    }
  }
  if ($self->{feed_enabled}) {
    my $age = defined $st->{last_event} ? $now - $st->{last_event} : $now - $self->{started};
    my $mx_busy = $mx && ($mx->{load}{scan}{msgs_10} // 0) > 0;
    if ($age > $self->{opt}{stale} && $mx_busy) {
      push @a, { level => 'warning',
                 text => sprintf('Messages are being scanned but no events arrived for %d min: does the filter call md_graphdefang_feed_enable()?', $age / 60) };
    } elsif ($age > $self->{opt}{stale} && !$self->{mx_enabled}) {
      push @a, { level => 'warning', text => sprintf('No events received for %d min', $age / 60) };
    }
  }
  return \@a;
}

sub _prom_label {
  my ($v) = @_;
  $v =~ s/(["\\])/\\$1/g;
  $v =~ s/\n/\\n/g;
  return $v;
}

sub metrics {
  my ($self) = @_;
  my $st = $self->{store};
  my $mx = $st->{mx};
  my @o;
  my $metric = sub {
    my ($name, $type, $help, @samples) = @_;
    push @o, "# HELP $name $help", "# TYPE $name $type";
    while (my ($labels, $val) = splice(@samples, 0, 2)) {
      push @o, $name . ($labels ne '' ? "{$labels}" : '') . ' ' . (defined $val ? $val : 'NaN');
    }
  };
  $metric->('mimedefang_dashboard_source_up', 'gauge', 'Whether a data source is reachable',
            'source="multiplexor"', ($mx ? 1 : 0),
            'source="feed"', ($st->{feed_count} || $self->{feed} ? 1 : 0));
  $metric->('mimedefang_events_total', 'counter', 'Events received from md_graphdefang_log since dashboard start',
            map { ('event="' . _prom_label($_) . '"', $st->{totals}{$_}) } sort keys %{ $st->{totals} });
  $metric->('mimedefang_dashboard_feed_datagrams_total', 'counter', 'Datagrams received on the feed socket',
            '', $st->{feed_count} + $st->{feed_errors});
  $metric->('mimedefang_dashboard_feed_errors_total', 'counter', 'Datagrams that were not MDLOG lines',
            '', $st->{feed_errors});
  if ($mx) {
    my $ws = $mx->{worker_states} || {};
    $metric->('mimedefang_workers', 'gauge', 'Workers by state',
              map { ("state=\"$_\"", $ws->{$_} // 0) } qw(busy idle stopped killed));
    $metric->('mimedefang_workers_max', 'gauge', 'Maximum number of workers', '', $ws->{max});
    $metric->('mimedefang_messages_processed_total', 'counter', 'Messages scanned since multiplexor start', '', $mx->{msgs});
    $metric->('mimedefang_worker_activations_total', 'counter', 'Workers started since multiplexor start', '', $mx->{activations});
    $metric->('mimedefang_request_queue_size', 'gauge', 'Size of the multiplexor request queue', '', $mx->{queue_size});
    $metric->('mimedefang_requests_queued', 'gauge', 'Requests waiting in the queue', '', $mx->{queued});
    $metric->('mimedefang_multiplexor_uptime_seconds', 'gauge', 'Multiplexor uptime', '', $mx->{uptime});
    my (@ams, @mps, @avg);
    for my $cmd (sort keys %{ $mx->{load} || {} }) {
      my $l = $mx->{load}{$cmd};
      for my $w ([ '0', '10s' ], [ '1', '1m' ], [ '5', '5m' ], [ '10', '10m' ]) {
        my $lab = "command=\"$cmd\",window=\"$w->[1]\"";
        push @ams, $lab, $l->{"ams_$w->[0]"};
        push @mps, $lab, $l->{"mps_$w->[0]"};
        push @avg, $lab, $l->{"avg_$w->[0]"};
      }
    }
    $metric->('mimedefang_scan_time_ms', 'gauge', 'Average milliseconds per request', @ams);
    $metric->('mimedefang_requests_per_second', 'gauge', 'Requests per second', @mps);
    $metric->('mimedefang_busy_workers_avg', 'gauge', 'Average busy workers while handling a request', @avg);
  }
  return join("\n", @o) . "\n";
}

#***********************************************************************
# HTTP
#***********************************************************************

my %STATUS = (200 => 'OK', 400 => 'Bad Request', 403 => 'Forbidden', 404 => 'Not Found',
              405 => 'Method Not Allowed', 413 => 'Payload Too Large', 503 => 'Service Unavailable');

my $CSP = "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; "
        . "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";

sub accept_clients {
  my ($self) = @_;
  while (my $c = $self->{listen}->accept) {
    if (keys %{ $self->{clients} } >= MAX_CLIENTS) {
      close $c;
      next;
    }
    nonblock($c);
    $self->{clients}{ fileno($c) } = { fh => $c, in => '', out => '', t => main::time() };
    $self->{sel}->add($c);
  }
  return;
}

sub close_client {
  my ($self, $c) = @_;
  $self->{sel}->remove($c->{fh});
  delete $self->{clients}{ fileno($c->{fh}) // -1 };
  close $c->{fh};
  return;
}

sub read_client {
  my ($self, $c) = @_;
  my $n = sysread($c->{fh}, my $buf, 8192);
  if (!defined $n) {
    return if $! == EAGAIN || $! == EWOULDBLOCK || $! == EINTR;
    return $self->close_client($c);
  }
  return $self->close_client($c) if $n == 0;
  return if $c->{sse} || $c->{done};    # ignore anything after the request
  $c->{in} .= $buf;
  if (length($c->{in}) > MAX_REQ) {
    return $self->respond($c, 413, 'text/plain', "Request too large\n");
  }
  my $end = index($c->{in}, "\r\n\r\n");
  $end = index($c->{in}, "\n\n") if $end < 0;
  return if $end < 0;
  $self->handle_request($c, substr($c->{in}, 0, $end));
  return;
}

sub url_decode {
  my ($s) = @_;
  $s =~ tr/+/ /;
  $s =~ s/%([0-9A-Fa-f]{2})/chr(hex($1))/ge;
  return Encode::decode('UTF-8', $s);
}

sub host_allowed {
  my ($self, $host) = @_;
  my @allow = @{ $self->{opt}{'allow-host'} || [] };
  return 1 if !@allow && !$self->{loopback};
  return 0 unless defined $host;
  $host = lc $host;
  $host =~ s/:\d+$// unless $host =~ /^\[[^\]]*\]$/;
  $host =~ s/^\[(.*)\]$/$1/;
  return 1 if $self->{loopback} && $host =~ /^(?:localhost|127\.0\.0\.1|::1)$/;
  return scalar grep { lc($_) eq $host } @allow;
}

sub handle_request {
  my ($self, $c, $head) = @_;
  $c->{done} = 1;
  my ($line, @hdr) = split /\r?\n/, $head;
  my ($method, $target) = ($line // '') =~ m{^([A-Z]+)\s+(\S+)\s+HTTP/\d\.\d$};
  return $self->respond($c, 400, 'text/plain', "Bad request\n") unless $method;
  my %h;
  for (@hdr) {
    $h{ lc $1 } = $2 if /^([^:]+):\s*(.*?)\s*$/;
  }
  return $self->respond($c, 403, 'text/plain', "Host not allowed\n")
    unless $self->host_allowed($h{host});
  return $self->respond($c, 405, 'text/plain', "Only GET is supported\n", { Allow => 'GET, HEAD' })
    unless $method eq 'GET' || $method eq 'HEAD';
  $c->{head_only} = $method eq 'HEAD';

  my ($path, $qs) = split /\?/, $target, 2;
  my %q;
  for (split /&/, $qs // '') {
    my ($k, $v) = split /=/, $_, 2;
    $q{ url_decode($k) } = url_decode($v // '');
  }
  my $now = main::time();
  my $st = $self->{store};

  if ($path eq '/' || $path eq '/index.html') {
    return $self->respond($c, 200, 'text/html; charset=utf-8', $self->{assets}{'index.html'});
  }
  if ($path eq '/app.css') {
    return $self->respond($c, 200, 'text/css; charset=utf-8', $self->{assets}{'app.css'});
  }
  if ($path eq '/app.js') {
    return $self->respond($c, 200, 'text/javascript; charset=utf-8', $self->{assets}{'app.js'});
  }
  if ($path eq '/logo.png') {
    return $self->respond($c, 200, 'image/png', $self->{assets}{'logo.png'},
                          { 'Cache-Control' => 'max-age=86400' });
  }
  if ($path eq '/favicon.png' || $path eq '/favicon.ico') {
    return $self->respond($c, 200, 'image/png', $self->{assets}{'favicon.png'},
                          { 'Cache-Control' => 'max-age=86400' });
  }
  if ($path eq '/apple-touch-icon.png') {
    return $self->respond($c, 200, 'image/png', $self->{assets}{'apple-touch-icon.png'},
                          { 'Cache-Control' => 'max-age=86400' });
  }
  if ($path eq '/metrics') {
    return $self->respond($c, 200, 'text/plain; version=0.0.4; charset=utf-8', $self->metrics);
  }
  if ($path eq '/api/stream') {
    return $self->start_sse($c);
  }
  my $data;
  if ($path eq '/api/summary') {
    $data = $self->summary;
  } elsif ($path eq '/api/workers') {
    my $mx = $st->{mx};
    $data = $mx ? { %$mx, up => \1 } : { up => \0, error => $self->{mx_error} };
  } elsif ($path eq '/api/series') {
    $data = $st->series($q{range}, $now);
  } elsif ($path eq '/api/top') {
    $data = $st->top(%q, now => $now);
  } elsif ($path eq '/api/events') {
    $data = $st->events(%q);
  } elsif ($path eq '/api/scores') {
    $data = $st->scores($q{window}, $now);
  } elsif ($path eq '/api/export') {
    return $self->export($c, \%q, $now);
  } else {
    return $self->respond($c, 404, 'text/plain', "Not found\n");
  }
  return $self->respond($c, 200, 'application/json', $JSON->encode($data));
}

sub _csv {
  my (@f) = @_;
  return join(',', map {
    my $v = $_ // '';
    $v = "'$v" if $v =~ /^[=+\-\@\t\r]/;    # no spreadsheet formulas
    $v =~ /[",\r\n]/ ? '"' . ($v =~ s/"/""/gr) . '"' : $v;
  } @f) . "\r\n";
}

sub export {
  my ($self, $c, $q, $now) = @_;
  my $st = $self->{store};
  my $what = ($q->{what} // 'events') eq 'series' ? 'series' : 'events';
  my $csv = ($q->{fmt} // 'json') eq 'csv';
  my $data = $what eq 'series' ? $st->series($q->{range}, $now)
                               : $st->events(%$q, limit => 1000);
  my $stamp = POSIX::strftime('%Y%m%d-%H%M%S', localtime($now));
  my $fname = "mimedefang-$what-$stamp." . ($csv ? 'csv' : 'json');
  my $hdr = { 'Content-Disposition' => "attachment; filename=\"$fname\"" };
  return $self->respond($c, 200, 'application/json', $JSON->encode($data), $hdr) unless $csv;

  my $out;
  if ($what eq 'events') {
    $out = _csv(qw(time id event value1 value2 sender recipient recipients subject));
    for my $e (@{ $data->{events} }) {
      $out .= _csv(POSIX::strftime('%Y-%m-%dT%H:%M:%S', localtime($e->{t})),
                   $e->{id}, $e->{event}, $e->{values}[0], $e->{values}[1],
                   $e->{sender}, $e->{rcpt}, $e->{rcpts}, $e->{subject});
    }
  } else {
    my @ev = @{ $data->{events} };
    $out = _csv('time', @ev, qw(mx_msgs mx_busy_avg mx_scan_ms mx_queued_max));
    for my $i (0 .. $data->{n} - 1) {
      $out .= _csv(POSIX::strftime('%Y-%m-%dT%H:%M:%S', localtime($data->{start} + $i * $data->{step})),
                   (map { $data->{ev}{$_}[$i] } @ev),
                   map { $data->{mx}{$_}[$i] } qw(msgs busy ams queued));
    }
  }
  return $self->respond($c, 200, 'text/csv; charset=utf-8', Encode::encode('UTF-8', $out), $hdr);
}

sub respond {
  my ($self, $c, $code, $type, $body, $extra) = @_;
  $c->{done} = 1;
  $body = Encode::encode('UTF-8', $body) if utf8::is_utf8($body);
  my %h = (
    'Content-Type' => $type,
    'Content-Length' => length($body),
    'Cache-Control' => 'no-store',
    'X-Content-Type-Options' => 'nosniff',
    'Referrer-Policy' => 'no-referrer',
    'Content-Security-Policy' => $CSP,
    'Connection' => 'close',
    %{ $extra || {} },
  );
  my $out = "HTTP/1.1 $code " . ($STATUS{$code} // 'OK') . "\r\n"
          . join('', map { "$_: $h{$_}\r\n" } sort keys %h) . "\r\n";
  $out .= $body unless $c->{head_only};
  $c->{out} .= $out;
  $c->{close_after} = 1;
  $self->flush_client($c);
  return;
}

sub start_sse {
  my ($self, $c) = @_;
  my $n = grep { $_->{sse} } values %{ $self->{clients} };
  return $self->respond($c, 503, 'text/plain', "Too many live clients\n") if $n >= MAX_SSE;
  $c->{sse} = 1;
  $c->{last_write} = main::time();
  $c->{out} .= "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-store\r\n"
             . "X-Content-Type-Options: nosniff\r\nX-Accel-Buffering: no\r\nConnection: keep-alive\r\n\r\n"
             . "retry: 3000\n\n"
             . "event: tick\ndata: " . $JSON->encode($self->summary(1)) . "\n\n";
  $self->flush_client($c);
  return;
}

sub sse_broadcast {
  my ($self, $event, $data) = @_;
  my $msg = "event: $event\ndata: " . $JSON->encode($data) . "\n\n";
  for my $c (values %{ $self->{clients} }) {
    next unless $c->{sse};
    if (length($c->{out}) > MAX_OUTBUF) {
      $self->close_client($c);    # client cannot keep up
      next;
    }
    $c->{out} .= $msg;
    $c->{last_write} = main::time();
    $self->flush_client($c);
  }
  return;
}

sub flush_client {
  my ($self, $c) = @_;
  while (length $c->{out}) {
    my $n = syswrite($c->{fh}, $c->{out});
    if (!defined $n) {
      return if $! == EAGAIN || $! == EWOULDBLOCK || $! == EINTR;
      return $self->close_client($c);
    }
    substr($c->{out}, 0, $n, '');
  }
  $self->close_client($c) if $c->{close_after};
  return;
}

#***********************************************************************
# Main loop
#***********************************************************************

sub run {
  my ($self, $stop) = @_;
  my $now = main::time();
  my %next = (poll => $now, save => $now + $self->{opt}{'state-interval'},
              prune => $now + 60, tick => $now + $self->{opt}{interval});
  while (!$stop->{stop}) {
    if ($stop->{save}) {
      $stop->{save} = 0;
      $self->save_state;
    }
    $now = main::time();
    if ($now >= $next{poll}) {
      $self->poll_mx;
      $next{poll} = $now + $self->{opt}{interval};
    }
    if ($now >= $next{tick}) {
      $self->sse_broadcast(tick => $self->summary(1));
      $next{tick} = $now + $self->{opt}{interval};
    }
    if ($now >= $next{prune}) {
      $self->{store}->prune($now);
      $next{prune} = $now + 60;
    }
    if ($self->{opt}{state} && $now >= $next{save}) {
      $self->save_state;
      $next{save} = $now + $self->{opt}{'state-interval'};
    }
    for my $c (values %{ $self->{clients} }) {
      if (!$c->{sse} && !$c->{done} && $now - $c->{t} > REQ_TIMEOUT) {
        $self->close_client($c);
      } elsif ($c->{sse} && $now - $c->{last_write} > SSE_HEARTBEAT) {
        $c->{out} .= ": keepalive\n\n";
        $c->{last_write} = $now;
        $self->flush_client($c);
      }
    }

    my $wsel = IO::Select->new(map { $_->{fh} } grep { length $_->{out} } values %{ $self->{clients} });
    my $timeout = 0.5;
    my ($r, $w) = IO::Select->select($self->{sel}, $wsel, undef, $timeout);
    for my $fh (@{ $r || [] }) {
      if ($self->{listen} && $fh == $self->{listen}) {
        $self->accept_clients;
      } elsif ($self->{feed} && $fh == $self->{feed}) {
        $self->drain_feed;
      } elsif (my $c = $self->{clients}{ fileno($fh) // -1 }) {
        $self->read_client($c);
      }
    }
    for my $fh (@{ $w || [] }) {
      my $c = $self->{clients}{ fileno($fh) // -1 } or next;
      $self->flush_client($c);
    }
    if (@{ $self->{pending} }) {
      $self->sse_broadcast(events => $self->{pending});
      $self->{pending} = [];
    }
    last if $self->{opt}{_once};
  }
  return;
}

sub cleanup {
  my ($self) = @_;
  $self->save_state;
  if ($self->{feed_path}) {
    unlink $self->{feed_path};
  }
  return;
}

package main; ## no critic (Modules::ProhibitMultiplePackages)

#***********************************************************************
# Embedded UI assets (in __DATA__, split on "@@ name" lines)
#***********************************************************************

my %ASSETS;
sub load_assets {
  return \%ASSETS if %ASSETS;
  my $name;
  my $pos = tell(DATA);
  my %b64;
  while (my $l = <DATA>) {
    if ($l =~ /^\@\@ (\S+)(\s+base64)?\s*$/) {
      $name = $1;
      $b64{$name} = 1 if $2;
      $ASSETS{$name} = '';
      next;
    }
    $ASSETS{$name} .= $l if defined $name;
  }
  seek(DATA, $pos, 0) if $pos >= 0;
  $ASSETS{$_} = MIME::Base64::decode_base64($ASSETS{$_}) for keys %b64;
  return \%ASSETS;
}

#***********************************************************************
# %PROCEDURE: check_privileges
# %ARGUMENTS:
#  euid, ruid -- user ids to check (default: the current ones)
# %RETURNS:
#  An error message, or undef when it is safe to run.
#***********************************************************************
sub check_privileges {
  my ($euid, $ruid) = @_;
  $euid //= $>;
  $ruid //= $<;
  return "mimedefang-dashboard must not run as root; run it as the MIMEDefang user, "
       . "e.g. 'runuser -u $DEFANGUSER -- mimedefang-dashboard' or systemd User=$DEFANGUSER\n"
    if $euid == 0 || $ruid == 0;
  return;
}

sub daemonize {
  my ($pidfile) = @_;
  defined(my $pid = fork()) or die "fork: $!\n";
  exit 0 if $pid;
  setsid() or die "setsid: $!\n";
  defined($pid = fork()) or die "fork: $!\n";
  exit 0 if $pid;
  chdir '/';
  open(STDIN, '<', '/dev/null');
  open(STDOUT, '>', '/dev/null');
  open(STDERR, '>', '/dev/null');
  return;
}

sub main {
  my @allow;
  # show "mimedefang-dashboard <args>" in ps instead of "perl /path/to/script ..."
  $0 = join(' ', 'mimedefang-dashboard', @ARGV);
  Getopt::Long::Configure('no_ignore_case');
  GetOptions(\%Opt,
    'listen|l=s', 'mx-socket|s=s', 'feed|f=s', 'feed-mode=s', 'interval|i=i',
    'history=i', 'state=s', 'state-interval=i', 'stale=i', 'spam-event=s',
    'ml-events=s', 'events=s', 'top-cap=i', 'anonymize', 'allow-host=s' => \@allow,
    'pidfile|p=s', 'daemon|d', 'syslog:s', 'quiet|q', 'help|h', 'man', 'version|v',
  ) or pod2usage(-exitval => 2, -input => __FILE__);
  pod2usage(-verbose => 1, -exitval => 0, -input => __FILE__) if $Opt{help};
  pod2usage(-verbose => 2, -exitval => 0, -input => __FILE__) if $Opt{man};
  if ($Opt{version}) {
    print "mimedefang-dashboard version $VERSION\n";
    return 0;
  }
  $Opt{'allow-host'} = \@allow;
  $Opt{interval} = 1 if $Opt{interval} < 1;
  $Opt{history} = 100 if $Opt{history} < 100;
  $Opt{'state-interval'} = 30 if $Opt{'state-interval'} < 30;
  die "Invalid --feed-mode\n" unless $Opt{'feed-mode'} =~ /^0?[0-7]{3}$/;

  if (my $err = check_privileges()) {
    print STDERR $err;
    return 1;
  }

  # STDERR is closed in daemon mode, so log to syslog instead
  $Opt{syslog} //= 'mail' if $Opt{daemon};
  if (defined $Opt{syslog}) {
    $Opt{syslog} = 'mail' if $Opt{syslog} eq '';
    die "Invalid --syslog facility '$Opt{syslog}'\n"
      unless $Opt{syslog} =~ /^(?:auth|authpriv|cron|daemon|ftp|kern|lpr|mail|news|syslog|user|uucp|local[0-7])$/;
    eval { Mail::MIMEDefang::md_openlog('mimedefang-dashboard', $Opt{syslog}); 1 }
      or die "Cannot open syslog: $@";
  }

  my $app = MDDash::App->new(%Opt);
  $app->load_state;
  $app->open_feed if $app->{feed_enabled};
  $app->open_listen;

  if ($Opt{daemon}) {
    daemonize();
  }
  if ($Opt{pidfile}) {
    open(my $fh, '>', $Opt{pidfile}) or die "Cannot write $Opt{pidfile}: $!\n";
    print {$fh} "$$\n";
    close $fh;
  }

  my $flags = { stop => 0, save => 0 };
  local $SIG{TERM} = sub { $flags->{stop} = 1 };
  local $SIG{INT}  = sub { $flags->{stop} = 1 };
  local $SIG{HUP}  = sub { $flags->{save} = 1 };
  local $SIG{PIPE} = 'IGNORE';

  $app->run($flags);
  $app->cleanup;
  unlink $Opt{pidfile} if $Opt{pidfile};
  return 0;
}

exit(main()) unless caller;

1;

=head1 NAME

mimedefang-dashboard - live web console for the MIMEDefang mail flow

=head1 SYNOPSIS

mimedefang-dashboard [options]

 Options:
   -l, --listen ADDR:PORT  HTTP listen address (default 127.0.0.1:8689)
   -s, --mx-socket PATH    multiplexor control socket, or "none"
   -f, --feed PATH         event feed datagram socket, or "none"
       --feed-mode MODE    permissions of the feed socket (default 0660)
   -i, --interval SECS     multiplexor polling interval (default 2)
       --history N         recent events kept in memory (default 5000)
       --state FILE        save aggregated data to FILE across restarts
       --state-interval S  seconds between state saves (default 300)
       --stale SECS        warn when no event arrived for SECS (default 900)
       --spam-event NAME   event whose first value is a spam score (default spam)
       --ml-events LIST    events whose first value is an ML confidence
                           (default ml_spam,ml_not_spam,ml_phishing,
                           ml_not_phishing,ml_unsure)
                           an event logged without a value is counted
                           but gets no histogram
       --events LIST       events that get the first chart colors, in order
                           (default mail_out,spam,mail_in)
       --top-cap N         keys kept per top-N counter slice (default 300)
       --anonymize         drop subjects and mask local parts
       --allow-host NAME   accepted HTTP Host header (repeatable)
   -p, --pidfile FILE      write process id to FILE
   -d, --daemon            detach from the terminal (implies --syslog)
       --syslog[=FACILITY] log to syslog instead of stderr (default mail)
   -q, --quiet             no log output
   -h, --help              brief help
       --man               full documentation
   -v, --version           print version

=head1 DESCRIPTION

B<mimedefang-dashboard> shows what MIMEDefang is doing right now: message
and event throughput, the state of every worker, scan latency, top senders,
recipients and domains, spam and machine-learning score distributions, and a
live, searchable stream of events.  It runs its own small HTTP server and
needs no web server, no database and no access to the mail log.  All data is
kept in memory; with B<--state> the aggregates survive a restart.

The dashboard refuses to run as root.  Run it as the MIMEDefang user
(B<@DEFANGUSER@>), which can read the multiplexor socket and create the
feed socket in the spool directory.

=head2 Data sources

=over 4

=item Multiplexor

Every B<--interval> seconds the dashboard sends B<jsonsnapshot> to the
multiplexor control socket (the same socket B<md-mx-ctrl> uses, or the
unprivileged one given to B<mimedefang-multiplexor -a>).  With an older
multiplexor it falls back to the B<status>, B<load> and B<histo> commands.

=item Event feed

The filter sends every B<md_graphdefang_log> event to a UNIX datagram
socket, F<@SPOOLDIR@/mimedefang-dashboard.sock> by default.  Enable it in
F<mimedefang-filter>:

    sub filter_initialize {
        md_graphdefang_feed_enable();
    }

or call it at the top level of the filter.  Delivery never blocks the
filter; events are dropped while the dashboard is not running.  This works
with or without B<md_graphdefang_log_enable>, which logs the same events to
syslog.

=back

=head2 HTTP interface

The user interface is served at F</>.  The JSON API is:

=over 4

=item F</api/summary>

Counters, source health and alerts.

=item F</api/workers>

The last multiplexor snapshot: worker list with status tags, load,
histogram and autoscale state.

=item F</api/series?range=1h|6h|24h|7d|30d>

Events per time step plus multiplexor samples.

=item F</api/top?dim=DIM&window=1h|24h&event=EVENT&n=N>

Top values for DIM: sender, sender_domain, rcpt, rcpt_domain, value1 or
value2.  Counts are approximate when there are many distinct values.

=item F</api/events?q=TEXT&event=EVENT&id=ID&limit=N>

Recent events, newest first.

=item F</api/scores?window=24h|7d>

Spam score and ML confidence histograms.

=item F</api/stream>

Server-Sent Events: B<events> (new events) and B<tick> (summary).

=item F</api/export?what=events|series&fmt=csv|json>

Download events or series.

=item F</metrics>

Prometheus text format.

=back

=head1 SECURITY

The dashboard listens on 127.0.0.1 by default and is read-only.  When it
listens on a loopback address only C<localhost>, C<127.0.0.1> and C<::1>
are accepted as HTTP Host, which defeats DNS rebinding; add names with
B<--allow-host>.  It has no authentication of its own: to reach it from
other hosts, put it behind a reverse proxy that handles TLS and
authentication.  Subjects and addresses are shown; use B<--anonymize> where
that is not acceptable.

=head2 Reverse proxy with Apache httpd

Keep the dashboard on its default loopback address and let Apache httpd
handle TLS and authentication.  You need B<mod_ssl>, B<mod_proxy>,
B<mod_proxy_http>, B<mod_headers>, B<mod_auth_basic> and B<mod_authn_file>.
A minimal virtual host:

    <VirtualHost *:443>
        ServerName dashboard.example.com
        SSLEngine on
        SSLCertificateFile    /etc/pki/tls/certs/dashboard.crt
        SSLCertificateKeyFile /etc/pki/tls/private/dashboard.key
        Header always set Strict-Transport-Security "max-age=31536000"

        ProxyRequests     Off
        ProxyPreserveHost Off
        ProxyTimeout      3600
        ProxyPass         /api/stream http://127.0.0.1:8689/api/stream flushpackets=on
        ProxyPass         /           http://127.0.0.1:8689/
        ProxyPassReverse  /           http://127.0.0.1:8689/

        <Location />
            AuthType Basic
            AuthName "MIMEDefang dashboard"
            AuthUserFile /etc/httpd/mimedefang-dashboard.htpasswd
            Require valid-user
        </Location>

        # Optional: let a Prometheus server scrape without a password
        <Location /metrics>
            Require ip 192.0.2.10
        </Location>
    </VirtualHost>

Create the password file with:

    htpasswd -c /etc/httpd/mimedefang-dashboard.htpasswd admin

Notes:

=over 4

=item *

The user interface uses absolute URLs, so the dashboard must be served at
the root of a virtual host, not under a sub-path such as F</dashboard/>.

=item *

With B<ProxyPreserveHost Off> (the Apache default) the dashboard sees
C<127.0.0.1:8689> as Host and needs no extra option.  With
B<ProxyPreserveHost On>, start it with
B<--allow-host dashboard.example.com>.

=item *

F</api/stream> is a Server-Sent Events stream: B<flushpackets=on> and a long
B<ProxyTimeout> keep the live view from stalling or being cut off.

=item *

Any other Apache authentication module, such as B<mod_auth_openidc> or
B<mod_authnz_ldap>, can replace Basic authentication.  Add B<Require ip>
to restrict access further.  Drop the F</metrics> block to keep the
Prometheus endpoint behind authentication too.

=item *

Make sure port 8689 cannot be reached from other hosts, for example with a
firewall rule, if the dashboard listens on a non-loopback address.

=back

=head1 SIGNALS

B<SIGTERM> and B<SIGINT> save the state file and exit.  B<SIGHUP> saves
the state file.

=head1 SEE ALSO

mimedefang-filter(5), mimedefang-multiplexor(8), md-mx-ctrl(8), httpd(8)

=cut

