@@ index.html
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MIMEDefang Dashboard</title>
<link rel="icon" href="/favicon.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/app.css">
</head>
<body>
<div class="app">
  <aside class="side">
    <div class="brand"><img src="/logo.png" alt="MIMEDefang" width="152" height="76"><span>Dashboard</span></div>
    <nav class="nav" aria-label="Views">
      <a href="#overview" data-view="overview">Overview</a>
      <a href="#flow" data-view="flow">Flow</a>
      <a href="#live" data-view="live">Live log</a>
      <a href="#workers" data-view="workers">Workers</a>
      <a href="#scores" data-view="scores">Scores</a>
    </nav>
    <div class="sources" id="sources" aria-live="polite"></div>
  </aside>
  <main class="main">
    <header class="top">
      <h1 id="title">Overview</h1>
      <div class="top-r">
        <span class="live" id="live-dot" title="Live connection"><i></i><span>connecting</span></span>
        <button class="btn ghost" id="theme" type="button" aria-label="Toggle theme">Theme</button>
      </div>
    </header>
    <div id="alerts" class="alerts" aria-live="polite"></div>

    <section class="view" id="v-overview">
      <div class="tiles" id="kpis"></div>
      <div class="card">
        <div class="card-h"><h2>Events</h2><div class="seg" data-range-for="overview"></div></div>
        <div class="chart" id="ov-events"></div>
        <div class="legend" id="ov-legend"></div>
      </div>
      <div class="grid3">
        <div class="card"><div class="card-h"><h3>Messages scanned</h3></div><div class="chart sm" id="ov-msgs"></div></div>
        <div class="card"><div class="card-h"><h3>Busy workers (avg)</h3></div><div class="chart sm" id="ov-busy"></div></div>
        <div class="card"><div class="card-h"><h3>Scan time (ms)</h3></div><div class="chart sm" id="ov-ams"></div></div>
      </div>
      <div class="card">
        <div class="card-h"><h2>Mail Event Percentage, last hour</h2></div>
        <div id="ov-mix"></div>
      </div>
    </section>

    <section class="view" id="v-flow" hidden>
      <div class="filters">
        <label>Event <select id="fl-event"></select></label>
        <label>Group by <select id="fl-dim">
          <option value="sender_domain">Sender domain</option>
          <option value="sender">Sender</option>
          <option value="rcpt_domain">Recipient domain</option>
          <option value="rcpt">Recipient</option>
          <option value="value1">Value 1</option>
          <option value="value2">Value 2</option>
        </select></label>
        <label>Top <select id="fl-window"><option value="1h">last hour</option><option value="24h">last 24 hours</option></select></label>
      </div>
      <div class="card">
        <div class="card-h"><h2 id="fl-chart-title">Events</h2><div class="seg" data-range-for="flow"></div></div>
        <div class="chart" id="fl-chart"></div>
        <div class="legend" id="fl-legend"></div>
      </div>
      <div class="card">
        <div class="card-h"><h2 id="fl-top-title">Top</h2><span class="hint">Select a row to see its events</span></div>
        <div id="fl-top"></div>
      </div>
    </section>

    <section class="view" id="v-live" hidden>
      <div class="filters">
        <input type="search" id="lv-q" placeholder="Filter: address, subject, value, queue id" aria-label="Filter events">
        <button class="btn" id="lv-pause" type="button" aria-pressed="false">Pause</button>
        <span class="hint" id="lv-count"></span>
        <span class="spacer"></span>
        <a class="btn ghost" href="/api/export?what=events&amp;fmt=csv">CSV</a>
        <a class="btn ghost" href="/api/export?what=events&amp;fmt=json">JSON</a>
      </div>
      <div class="chips" id="lv-chips"></div>
      <div class="msgpanel" id="lv-msg" hidden></div>
      <div class="card flush">
        <div class="tablewrap">
          <table class="log">
            <thead><tr><th>Server Time</th><th>Event</th><th>Value 1</th><th>Value 2</th><th>Sender</th><th>Recipient</th><th>Subject</th></tr></thead>
            <tbody id="lv-body"></tbody>
          </table>
        </div>
        <p class="empty" id="lv-empty">No events yet. Events appear here as soon as the filter sends them; see <code>md_graphdefang_feed_enable</code>.</p>
      </div>
    </section>

    <section class="view" id="v-workers" hidden>
      <div class="tiles" id="wk-tiles"></div>
      <div class="card">
        <div class="card-h"><h2>Workers</h2><div class="legend inline" id="wk-legend"></div></div>
        <div id="wk-groups"></div>
      </div>
      <div class="grid2">
        <div class="card">
          <div class="card-h"><h2>Load</h2></div>
          <div class="tablewrap"><table class="num" id="wk-load"></table></div>
          <div class="tablewrap"><table class="num" id="wk-hload"></table></div>
        </div>
        <div class="card">
          <div class="card-h"><h2>Busy workers per request</h2></div>
          <div class="chart sm" id="wk-histo"></div>
          <div class="kv" id="wk-autoscale"></div>
        </div>
      </div>
    </section>

    <section class="view" id="v-scores" hidden>
      <div class="filters">
        <label>Window <select id="sc-window"><option value="24h">last 24 hours</option><option value="7d">last 7 days</option></select></label>
      </div>
      <div class="card">
        <div class="card-h"><h2 id="sc-spam-title">Spam score</h2></div>
        <div class="chart sm" id="sc-spam"></div>
      </div>
      <div class="grid3" id="sc-ml"></div>
      <div class="card">
        <div class="card-h"><h2>ML verdicts over time</h2><div class="seg" data-range-for="scores"></div></div>
        <div class="chart" id="sc-series"></div>
        <div class="legend" id="sc-legend"></div>
      </div>
    </section>
  </main>
</div>
<div class="tip" id="tip" role="tooltip" hidden></div>
<script src="/app.js"></script>
</body>
</html>
@@ app.css
:root {
  color-scheme: light;
  --page: #f9f9f7;
  --surface: #fcfcfb;
  --raised: #ffffff;
  --ink: #0b0b0b;
  --ink2: #52514e;
  --muted: #898781;
  --grid: #e1e0d9;
  --axis: #c3c2b7;
  --border: rgba(11, 11, 11, 0.10);
  --hover: rgba(11, 11, 11, 0.04);
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100;
  --s5: #e87ba4; --s6: #008300; --s7: #6250d6; --other: #a8a69f;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
  --accent: #2a78d6;
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) .brand img { filter: invert(1) hue-rotate(180deg); }
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --raised: #20201f;
    --ink: #f0efec; --ink2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835;
    --border: rgba(255, 255, 255, 0.10); --hover: rgba(255, 255, 255, 0.05);
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
    --s5: #d55181; --s6: #008300; --s7: #9085e9; --other: #6f6e69;
    --accent: #3987e5;
  }
}
:root[data-theme="dark"] .brand img { filter: invert(1) hue-rotate(180deg); }
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --raised: #20201f;
  --ink: #f0efec; --ink2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --axis: #383835;
  --border: rgba(255, 255, 255, 0.10); --hover: rgba(255, 255, 255, 0.05);
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500;
  --s5: #d55181; --s6: #008300; --s7: #9085e9; --other: #6f6e69;
  --accent: #3987e5;
}

* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: var(--page); color: var(--ink); font: 14px/1.45 var(--sans); }
a { color: var(--accent); }
code { font-family: var(--mono); font-size: 12.5px; }
[hidden] { display: none !important; }

.app { display: grid; grid-template-columns: 208px minmax(0, 1fr); min-height: 100vh; }
.side { border-right: 1px solid var(--border); padding: 18px 12px; display: flex; flex-direction: column; gap: 18px; position: sticky; top: 0; height: 100vh; }
.brand { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 0 8px; }
.brand img { display: block; width: 120px; height: auto; }
.brand span { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding-left: 2px; }
.nav { display: flex; flex-direction: column; gap: 2px; }
.nav a { color: var(--ink2); text-decoration: none; padding: 7px 10px; border-radius: 6px; font-weight: 500; }
.nav a:hover { background: var(--hover); color: var(--ink); }
.nav a[aria-current="page"] { background: var(--raised); color: var(--ink); box-shadow: inset 0 0 0 1px var(--border); }
.sources { margin-top: auto; display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--ink2); padding: 0 8px; }
.src { display: flex; align-items: center; gap: 8px; }
.src b { font-weight: 600; color: var(--ink); }
.src small { display: block; color: var(--muted); }

.main { padding: 18px 28px 40px; min-width: 0; }
.top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.top h1 { font-size: 20px; margin: 0; letter-spacing: -0.015em; }
.top-r { display: flex; align-items: center; gap: 10px; }
.live { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.live i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
.live.on i { background: var(--good); box-shadow: 0 0 0 3px color-mix(in srgb, var(--good) 22%, transparent); }
.live.off i { background: var(--critical); }

.btn { font: inherit; font-size: 13px; color: var(--ink); background: var(--raised); border: 1px solid var(--border); border-radius: 6px; padding: 5px 11px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
.btn:hover { background: var(--hover); }
.btn.ghost { background: transparent; }
.btn[aria-pressed="true"] { background: var(--ink); color: var(--page); }
select, input[type="search"] { font: inherit; font-size: 13px; color: var(--ink); background: var(--raised); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }
input[type="search"] { min-width: 0; width: 340px; max-width: 100%; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.alerts { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.alerts:empty { display: none; }
.alert { display: flex; gap: 10px; align-items: flex-start; padding: 9px 12px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); font-size: 13px; }
.alert .ic { flex: none; width: 18px; height: 18px; border-radius: 50%; color: #fff; font-weight: 700; font-size: 12px; display: grid; place-items: center; }
.alert.warning .ic { background: var(--warning); color: #0b0b0b; }
.alert.serious .ic { background: var(--serious); color: #0b0b0b; }
.alert.critical .ic { background: var(--critical); }
.alert .lv { font-weight: 600; text-transform: capitalize; margin-right: 4px; }

.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 14px; }
.tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
.tile .k { font-size: 12px; color: var(--ink2); }
.tile .v { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px; }
.tile .v small { font-size: 13px; color: var(--muted); font-weight: 500; margin-left: 3px; }
.tile .s { font-size: 12px; color: var(--muted); margin-top: 2px; }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; min-width: 0; }
.card.flush { padding: 0; overflow: hidden; }
.card-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
.card h2 { font-size: 14px; margin: 0; font-weight: 600; }
.card h3 { font-size: 13px; margin: 0; font-weight: 600; color: var(--ink2); }
.hint { font-size: 12px; color: var(--muted); }
.grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.grid2 > .card, .grid3 > .card { margin-bottom: 0; }
.grid2, .grid3 { margin-bottom: 14px; }

.seg { display: inline-flex; border: 1px solid var(--border); border-radius: 7px; padding: 2px; gap: 2px; background: var(--page); }
.seg button { font: inherit; font-size: 12px; border: 0; background: transparent; color: var(--ink2); padding: 3px 9px; border-radius: 5px; cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--raised); color: var(--ink); box-shadow: 0 0 0 1px var(--border); }

.chart { height: 240px; position: relative; }
.chart.sm { height: 150px; }
.chart svg { display: block; width: 100%; height: 100%; overflow: visible; }
.chart .nodata { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); font-size: 13px; }
.ax text { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.ax line { stroke: var(--grid); stroke-width: 1; shape-rendering: crispEdges; }
.ax .base { stroke: var(--axis); }
.xh { stroke: var(--ink2); stroke-width: 1; shape-rendering: crispEdges; }

.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 10px; font-size: 12px; color: var(--ink2); }
.legend.inline { margin-top: 0; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
.sw { width: 10px; height: 10px; border-radius: 3px; flex: none; display: inline-block; }

.tip { position: fixed; z-index: 10; pointer-events: none; background: var(--raised); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 12px; box-shadow: 0 6px 24px rgba(0,0,0,0.14); min-width: 140px; max-width: 320px; }
.tip .th { color: var(--ink2); margin-bottom: 4px; }
.tip .tr { display: flex; align-items: center; gap: 6px; justify-content: space-between; }
.tip .tr span:first-child { display: inline-flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tip .tr b { font-variant-numeric: tabular-nums; }
.tip .tt { border-top: 1px solid var(--border); margin-top: 4px; padding-top: 4px; }

.mix { display: flex; height: 14px; border-radius: 4px; overflow: hidden; gap: 2px; background: var(--surface); }
.mix div { min-width: 2px; }

.filters { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; margin-bottom: 14px; font-size: 13px; color: var(--ink2); }
.filters label { display: inline-flex; align-items: center; gap: 6px; }
.spacer { flex: 1; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.chip { font: inherit; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--ink2); border-radius: 999px; padding: 3px 10px; cursor: pointer; }
.chip[aria-pressed="true"] { color: var(--ink); background: var(--raised); box-shadow: inset 0 0 0 1px var(--ink2); }
.chip b { font-weight: 600; font-variant-numeric: tabular-nums; }

.tablewrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 12.5px; }
th { text-align: left; font-weight: 600; color: var(--ink2); font-size: 12px; padding: 7px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
td { padding: 6px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
tr:last-child td { border-bottom: 0; }
table.num td, table.num th { text-align: right; font-variant-numeric: tabular-nums; }
table.num td:first-child, table.num th:first-child { text-align: left; }
table.num + table.num, .tablewrap + .tablewrap { margin-top: 14px; }
table.log { font-family: var(--mono); font-size: 12px; }
table.log td { white-space: nowrap; max-width: 280px; overflow: hidden; text-overflow: ellipsis; }
table.log td.subj { white-space: normal; min-width: 220px; max-width: 420px; font-family: var(--sans); font-size: 12.5px; }
table.log tbody tr { cursor: pointer; }
table.log tbody tr:hover { background: var(--hover); }
table.log tr.new td { animation: flash 1.2s ease-out; }
@keyframes flash { from { background: color-mix(in srgb, var(--accent) 14%, transparent); } to { background: transparent; } }
.evt { display: inline-flex; align-items: center; gap: 6px; }
.empty { color: var(--muted); padding: 22px 16px; margin: 0; font-size: 13px; }
.msgpanel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; font-size: 13px; }
.msgpanel h3 { margin: 0 0 8px; font-size: 13px; }
.msgpanel h3 code { font-weight: 500; }
.msgpanel .btn { float: right; }

.top-list { display: grid; grid-template-columns: minmax(0, 1fr) 64px; gap: 2px 12px; font-size: 13px; }
.top-row { display: contents; cursor: pointer; }
.top-row > div { padding: 5px 6px; border-radius: 5px; }
.top-row:hover > div { background: var(--hover); }
.top-k { position: relative; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 12.5px; }
.top-k .bar { position: absolute; left: 0; top: 3px; bottom: 3px; border-radius: 0 4px 4px 0; opacity: 0.22; }
.top-k span { position: relative; }
.top-c { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }

.workers { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 8px; }
.wk { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 12px; background: var(--page); min-width: 0; }
.wk .h { display: flex; align-items: center; justify-content: space-between; font-weight: 600; }
.wk .st { display: inline-flex; align-items: center; gap: 5px; font-weight: 500; color: var(--ink2); }
.wk .tag { font-family: var(--mono); color: var(--ink); margin: 4px 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-height: 1.4em; }
.wk .m { color: var(--muted); font-variant-numeric: tabular-nums; }
.wk.busy { border-color: color-mix(in srgb, var(--s1) 55%, var(--border)); background: color-mix(in srgb, var(--s1) 7%, var(--surface)); }
.wk-group + .wk-group { margin-top: 14px; }
.wk-group h3 { margin: 0 0 6px; font-size: 13px; font-weight: 600; color: var(--ink2); }
.wk-group h3 .hint { font-weight: 500; margin-left: 4px; }
.wk.killed { border-color: var(--critical); }
.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex: none; }
.dot.idle { background: var(--good); }
.dot.busy { background: var(--s1); }
.dot.stopped { background: transparent; box-shadow: inset 0 0 0 1.5px var(--muted); }
.dot.killed { background: var(--critical); }
.kv { display: grid; grid-template-columns: auto 1fr; gap: 3px 14px; font-size: 12.5px; margin-top: 12px; }
.kv dt { color: var(--ink2); }
.kv dd { margin: 0; font-variant-numeric: tabular-nums; }

@media (max-width: 1100px) { .grid3 { grid-template-columns: 1fr; } }
@media (max-width: 860px) {
  .app { grid-template-columns: 1fr; }
  .side { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--border); padding: 12px 16px; gap: 10px; }
  .brand { flex-direction: row; align-items: center; gap: 10px; padding: 0; }
  .brand img { width: 84px; }
  .nav { flex-direction: row; overflow-x: auto; }
  .nav a { white-space: nowrap; }
  .sources { flex-direction: row; flex-wrap: wrap; gap: 6px 14px; margin-top: 0; padding: 0; }
  .main { padding: 14px 16px 32px; }
  .grid2 { grid-template-columns: 1fr; }
  .chart { height: 200px; }
}
@media (forced-colors: active) {
  .sw, .dot, .mix div { forced-color-adjust: none; }
}
@@ app.js
'use strict';
(function () {
  // ---------- helpers ----------
  const $ = (id) => document.getElementById(id);
  const SVGNS = 'http://www.w3.org/2000/svg';

  function h(tag, attrs, ...kids) {
    const el = document.createElement(tag);
    for (const k in attrs || {}) {
      const v = attrs[k];
      if (v == null || v === false) continue;
      if (k === 'class') el.className = v;
      else if (k === 'text') el.textContent = v;
      else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
      else el.setAttribute(k, v === true ? '' : v);
    }
    for (const c of kids.flat()) {
      if (c == null || c === false) continue;
      el.append(c instanceof Node ? c : document.createTextNode(String(c)));
    }
    return el;
  }
  function s(tag, attrs) {
    const el = document.createElementNS(SVGNS, tag);
    for (const k in attrs || {}) el.setAttribute(k, attrs[k]);
    return el;
  }
  const fmt = new Intl.NumberFormat();
  function num(v, d) {
    if (v == null || Number.isNaN(v)) return '–';
    if (d != null) return Number(v).toFixed(d);
    return fmt.format(v);
  }
  function compact(v) {
    if (v == null) return '–';
    const a = Math.abs(v);
    if (a >= 1e6) return (v / 1e6).toFixed(a >= 1e7 ? 0 : 1) + 'M';
    if (a >= 1e4) return (v / 1e3).toFixed(a >= 1e5 ? 0 : 1) + 'k';
    return Math.round(v * 100) / 100 + '';
  }
  function dur(sec) {
    if (sec == null || sec < 0) return '–';
    if (sec < 60) return Math.round(sec) + 's';
    if (sec < 3600) return Math.floor(sec / 60) + 'm ' + Math.round(sec % 60) + 's';
    if (sec < 86400) return Math.floor(sec / 3600) + 'h ' + Math.floor((sec % 3600) / 60) + 'm';
    return Math.floor(sec / 86400) + 'd ' + Math.floor((sec % 86400) / 3600) + 'h';
  }
  function tclock(t) {
    return new Date(t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }
  async function api(path) {
    const r = await fetch(path, { cache: 'no-store' });
    if (!r.ok) throw new Error(path + ': ' + r.status);
    return r.json();
  }
  function store(k, v) {
    try {
      if (v === undefined) return localStorage.getItem('mdd.' + k);
      localStorage.setItem('mdd.' + k, v);
    } catch (e) { /* storage unavailable */ }
    return null;
  }

  // ---------- color: stable slot per event ----------
  let slots = {};
  function color(ev) {
    const n = slots[ev];
    return n && n <= 7 ? 'var(--s' + n + ')' : 'var(--other)';
  }
  function swatch(c) {
    const el = h('i', { class: 'sw' });
    el.style.background = c;
    return el;
  }
  // At most 7 named series; the rest fold into "Other"
  function foldSeries(names, ev, n) {
    const out = [];
    let other = null;
    for (const name of names) {
      const sl = slots[name];
      if (sl && sl <= 7) out.push({ name, color: color(name), data: ev[name] });
      else {
        if (!other) other = { name: 'Other', color: 'var(--other)', data: new Array(n).fill(0), members: [] };
        other.members.push(name);
        ev[name].forEach((v, i) => { other.data[i] += v; });
      }
    }
    out.sort((a, b) => slots[a.name] - slots[b.name]);
    if (other) out.push(other);
    return out;
  }

  // ---------- tooltip ----------
  const tip = $('tip');
  function showTip(x, y, head, rows, total) {
    tip.replaceChildren(h('div', { class: 'th', text: head }));
    for (const r of rows) {
      tip.append(h('div', { class: 'tr' },
        h('span', null, r.color ? swatch(r.color) : null, r.name),
        h('b', { text: r.value })));
    }
    if (total != null) tip.append(h('div', { class: 'tr tt' }, h('span', { text: 'Total' }), h('b', { text: total })));
    tip.hidden = false;
    const w = tip.offsetWidth, ht = tip.offsetHeight;
    let left = x + 14, top = y + 14;
    if (left + w > window.innerWidth - 8) left = x - w - 14;
    if (top + ht > window.innerHeight - 8) top = y - ht - 14;
    tip.style.left = Math.max(8, left) + 'px';
    tip.style.top = Math.max(8, top) + 'px';
  }
  function hideTip() { tip.hidden = true; }

  // ---------- charts ----------
  // Axis maximum split into 4 round steps; integer steps unless frac
  function niceMax(v, frac) {
    if (!(v > 0)) return frac ? 1 : 4;
    const raw = v / 4;
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    let step = 10 * p;
    for (const m of [1, 2, 2.5, 5, 10]) {
      if (m * p >= raw && (frac || p >= 10 || m !== 2.5)) { step = m * p; break; }
    }
    if (!frac) step = Math.max(1, Math.round(step));
    return step * 4;
  }
  function timeLabel(t, step, span) {
    const d = new Date(t * 1000);
    if (span > 2 * 86400) return d.toLocaleDateString([], { month: 'short', day: 'numeric' }) + (step < 86400 && span <= 8 * 86400 ? ' ' + d.toLocaleTimeString([], { hour: '2-digit' }) : '');
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }
  function rangeLabel(t, step) {
    const a = new Date(t * 1000), b = new Date((t + step) * 1000);
    const o = { hour: '2-digit', minute: '2-digit' };
    const day = step >= 3600 ? a.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' }) + ' ' : '';
    return day + a.toLocaleTimeString([], o) + '–' + b.toLocaleTimeString([], o);
  }

  // Shared frame: axes and hover overlay.  Returns geometry helpers.
  function frame(el, opt) {
    el.replaceChildren();
    const W = Math.max(el.clientWidth, 240), H = Math.max(el.clientHeight, 120);
    const m = { l: 40, r: 8, t: 8, b: 22 };
    const iw = W - m.l - m.r, ih = H - m.t - m.b;
    const svg = s('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': opt.label || 'chart' });
    const ymax = niceMax(opt.ymax, opt.frac);
    const ax = s('g', { class: 'ax' });
    for (let k = 0; k <= 4; k++) {
      const v = ymax * k / 4, y = m.t + ih - ih * k / 4;
      ax.append(s('line', { x1: m.l, x2: m.l + iw, y1: y, y2: y, class: k === 0 ? 'base' : '' }));
      const t = s('text', { x: m.l - 6, y: y + 3.5, 'text-anchor': 'end' });
      t.textContent = compact(v);
      ax.append(t);
    }
    if (opt.xticks) {
      for (const xt of opt.xticks(iw)) {
        const t = s('text', { x: m.l + xt.x, y: H - 5, 'text-anchor': 'middle' });
        t.textContent = xt.label;
        ax.append(t);
      }
    }
    svg.append(ax);
    el.append(svg);
    return { svg, W, H, m, iw, ih, ymax, y: (v) => m.t + ih - (v / ymax) * ih };
  }
  function timeTicks(d) {
    return (iw) => {
      const span = d.n * d.step, want = Math.max(2, Math.floor(iw / 90));
      const every = Math.max(1, Math.ceil(d.n / want));
      const out = [];
      for (let i = 0; i < d.n; i += every) {
        out.push({ x: (i + 0.5) * iw / d.n, label: timeLabel(d.start + i * d.step, d.step, span) });
      }
      return out;
    };
  }
  function noData(el, text) {
    el.replaceChildren(h('div', { class: 'nodata', text: text || 'No data in this range' }));
  }

  // Stacked bars (kind 'bar') or stacked area (kind 'area') over time
  function stacked(el, d, series, kind, label) {
    const n = d.n;
    const totals = new Array(n).fill(0);
    series.forEach((se) => se.data.forEach((v, i) => { totals[i] += v || 0; }));
    if (!series.length || !totals.some((v) => v > 0)) return noData(el);
    const f = frame(el, { ymax: Math.max(...totals), xticks: timeTicks(d), label });
    const bw = f.iw / n;
    const g = s('g');
    if (kind === 'area') {
      const base = new Array(n).fill(0);
      const x = (i) => f.m.l + (i + 0.5) * bw;
      for (const se of series) {
        const top = base.map((b, i) => b + (se.data[i] || 0));
        let dpath = 'M' + x(0) + ',' + f.y(top[0]);
        for (let i = 1; i < n; i++) dpath += 'L' + x(i) + ',' + f.y(top[i]);
        for (let i = n - 1; i >= 0; i--) dpath += 'L' + x(i) + ',' + f.y(base[i]);
        const p = s('path', { d: dpath + 'Z' });
        p.style.fill = se.color;
        p.style.fillOpacity = '0.88';
        p.style.stroke = 'var(--surface)';
        p.style.strokeWidth = '1.5';
        g.append(p);
        top.forEach((v, i) => { base[i] = v; });
      }
    } else {
      const gap = bw > 6 ? Math.min(2, bw * 0.2) : 0.5;
      for (let i = 0; i < n; i++) {
        let acc = 0;
        series.forEach((se, k) => {
          const v = se.data[i] || 0;
          if (!v) return;
          const y0 = f.y(acc), y1 = f.y(acc + v);
          const r = s('rect', { x: f.m.l + i * bw + gap / 2, width: Math.max(0.5, bw - gap), y: y1, height: Math.max(0.5, y0 - y1 - (acc > 0 ? 1 : 0)) });
          if (k === series.length - 1 || acc + v === totals[i]) r.setAttribute('rx', Math.min(2, bw / 4));
          r.style.fill = se.color;
          g.append(r);
          acc += v;
        });
      }
    }
    f.svg.append(g);
    hover(f, d, (i) => ({
      head: rangeLabel(d.start + i * d.step, d.step),
      rows: series.filter((se) => se.data[i]).map((se) => ({ name: se.name, color: se.color, value: num(se.data[i]) })).reverse(),
      total: series.length > 1 ? num(totals[i]) : null,
    }));
  }

  // Single series line with gaps for missing samples
  function line(el, d, data, colorVar, fmtv, label) {
    const vals = data.filter((v) => v != null);
    if (!vals.length) return noData(el, 'No multiplexor samples');
    const f = frame(el, { ymax: Math.max(...vals), xticks: timeTicks(d), label, frac: true });
    const bw = f.iw / d.n;
    let p = '', pen = false;
    data.forEach((v, i) => {
      if (v == null) { pen = false; return; }
      p += (pen ? 'L' : 'M') + (f.m.l + (i + 0.5) * bw) + ',' + f.y(v);
      pen = true;
    });
    const path = s('path', { d: p, fill: 'none', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' });
    path.style.stroke = colorVar;
    f.svg.append(path);
    hover(f, d, (i) => ({ head: rangeLabel(d.start + i * d.step, d.step), rows: [{ name: label, color: colorVar, value: data[i] == null ? 'no sample' : fmtv(data[i]) }] }), (i) => data[i]);
  }

  function hover(f, d, info, yOf) {
    const bw = f.iw / d.n;
    const xh = s('line', { class: 'xh', y1: f.m.t, y2: f.m.t + f.ih });
    xh.style.display = 'none';
    const dot = s('circle', { r: 4 });
    dot.style.display = 'none';
    dot.style.fill = 'var(--ink)';
    dot.style.stroke = 'var(--surface)';
    dot.style.strokeWidth = '2';
    const ov = s('rect', { x: f.m.l, y: f.m.t, width: f.iw, height: f.ih, fill: 'transparent' });
    f.svg.append(xh, dot, ov);
    const move = (ev) => {
      const r = f.svg.getBoundingClientRect();
      const px = (ev.clientX - r.left) * (f.W / r.width) - f.m.l;
      const i = Math.min(d.n - 1, Math.max(0, Math.floor(px / bw)));
      const x = f.m.l + (i + 0.5) * bw;
      xh.setAttribute('x1', x); xh.setAttribute('x2', x);
      xh.style.display = '';
      if (yOf && yOf(i) != null) {
        dot.setAttribute('cx', x); dot.setAttribute('cy', f.y(yOf(i)));
        dot.style.display = '';
      } else dot.style.display = 'none';
      const t = info(i);
      showTip(ev.clientX, ev.clientY, t.head, t.rows.length ? t.rows : [{ name: 'No events', value: '' }], t.total);
    };
    ov.addEventListener('pointermove', move);
    ov.addEventListener('pointerleave', () => { xh.style.display = 'none'; dot.style.display = 'none'; hideTip(); });
  }

  // Histogram: categorical x labels, one series
  function bars(el, labels, values, colorVar, label, fmtx) {
    if (!values.some((v) => v > 0)) return noData(el);
    const n = labels.length;
    const want = (iw) => Math.max(2, Math.floor(iw / 44));
    const f = frame(el, {
      ymax: Math.max(...values), label,
      xticks: (iw) => {
        const every = Math.max(1, Math.ceil(n / want(iw)));
        const out = [];
        for (let i = 0; i < n; i += every) out.push({ x: (i + 0.5) * iw / n, label: labels[i] });
        return out;
      },
    });
    const bw = f.iw / n, gap = Math.min(2, bw * 0.25);
    values.forEach((v, i) => {
      if (!v) return;
      const r = s('rect', { x: f.m.l + i * bw + gap / 2, width: Math.max(1, bw - gap), y: f.y(v), height: f.y(0) - f.y(v), rx: Math.min(3, bw / 4) });
      r.style.fill = colorVar;
      f.svg.append(r);
    });
    hover(f, { n }, (i) => ({ head: fmtx(i), rows: [{ name: label, color: colorVar, value: num(values[i]) }] }));
  }

  function legend(el, series) {
    el.replaceChildren();
    if (series.length < 2) return;
    for (const se of series) {
      const tot = se.data.reduce((a, b) => a + (b || 0), 0);
      const name = se.members ? 'Other (' + se.members.join(', ') + ')' : se.name;
      el.append(h('span', null, swatch(se.color), name, h('b', { text: num(tot) })));
    }
  }

  function rangeSeg(view, onChange) {
    const el = document.querySelector(`[data-range-for="${view}"]`);
    const key = 'range.' + view;
    let cur = store(key) || '1h';
    el.replaceChildren();
    for (const r of ['1h', '6h', '24h', '7d', '30d']) {
      el.append(h('button', {
        type: 'button', text: r, 'aria-pressed': r === cur ? 'true' : 'false',
        onclick: () => {
          cur = r; store(key, r);
          for (const b of el.children) b.setAttribute('aria-pressed', b.textContent === r ? 'true' : 'false');
          onChange(r);
        },
      }));
    }
    return () => cur;
  }

  // ---------- global state ----------
  const S = { summary: null, view: 'overview', events: [], paused: false, evFilter: new Set(), lastLive: 0 };
  const MAXLIVE = 1000;

  // ---------- sources / alerts / kpis ----------
  function renderChrome(sum) {
    S.summary = sum;
    slots = sum.slots || slots;
    const src = $('sources');
    src.replaceChildren();
    const mx = sum.mx, fd = sum.feed;
    const row = (state, name, detail) => h('div', { class: 'src' }, h('i', { class: 'dot ' + state }), h('div', null, h('b', { text: name }), h('small', { text: detail })));
    if (mx.enabled) {
      src.append(row(mx.up ? 'idle' : 'killed', 'Multiplexor', mx.up ? 'v' + (mx.version || '?') + (mx.legacy ? ' (text protocol)' : '') + ' · up ' + dur(mx.uptime) : 'unreachable'));
    }
    if (fd.enabled) {
      const age = fd.last_event_age;
      src.append(row(age != null && age < 600 ? 'idle' : 'stopped', 'Event feed', age == null ? 'no events yet' : num(fd.received) + ' events · last ' + dur(age) + ' ago'));
    }
    const al = $('alerts');
    al.replaceChildren();
    const icon = { warning: '!', serious: '!', critical: '×' };
    for (const a of sum.alerts || []) {
      al.append(h('div', { class: 'alert ' + a.level, role: 'status' }, h('span', { class: 'ic', 'aria-hidden': 'true', text: icon[a.level] || 'i' }), h('div', null, h('span', { class: 'lv', text: a.level + ':' }), a.text)));
    }
  }

  function tile(k, v, unit, sub) {
    return h('div', { class: 'tile' }, h('div', { class: 'k', text: k }), h('div', { class: 'v' }, v, unit ? h('small', { text: unit }) : null), sub ? h('div', { class: 's', text: sub }) : null);
  }

  function renderKpis() {
    const sum = S.summary;
    if (!sum) return;
    const mx = sum.mx, l = mx.load || {};
    const ws = mx.worker_states || {};
    const ev1 = sum.events_1h || {};
    const total1h = Object.values(ev1).reduce((a, b) => a + b, 0);
    const k = $('kpis');
    k.replaceChildren(
      tile('Scanned / min', mx.up ? num(l.msgs_1) : '–', null, mx.up ? num(l.msgs_10) + ' in 10 min' : 'multiplexor not available'),
      tile('Avg scan time', mx.up && l.msgs_1 ? num(l.ams_1, 0) : '–', mx.up && l.msgs_1 ? 'ms' : null, mx.up ? '10 min: ' + (l.msgs_10 ? num(l.ams_10, 0) + ' ms' : '–') : null),
      tile('Busy workers', mx.up ? num(ws.busy) : '–', mx.up ? '/ ' + ws.max : null, mx.up ? num(ws.idle) + ' idle · ' + num(ws.stopped) + ' stopped' : null),
      tile('Queue', mx.up ? num(mx.queued) : '–', mx.up ? '/ ' + mx.queue_size : null, mx.up ? (mx.queue_size ? 'queueing enabled' : 'queueing disabled') : null),
      tile('Events, 1 h', num(total1h), null, num(Object.values(sum.events_24h || {}).reduce((a, b) => a + b, 0)) + ' in 24 h'),
    );
    // event mix (sorted by count, colors by slot)
    const mix = $('ov-mix');
    mix.replaceChildren();
    const names = Object.keys(ev1).sort((a, b) => ev1[b] - ev1[a]);
    if (!total1h) { mix.append(h('p', { class: 'hint', text: 'No events in the last hour.' })); return; }
    const bar = h('div', { class: 'mix', role: 'img', 'aria-label': 'Mail Event Percentage' });
    const leg = h('div', { class: 'legend' });
    for (const n of names) {
      const seg = h('div');
      seg.style.flex = String(ev1[n]);
      seg.style.background = color(n);
      seg.addEventListener('pointermove', (e) => showTip(e.clientX, e.clientY, 'Last hour', [{ name: n, color: color(n), value: num(ev1[n]) + ' · ' + (100 * ev1[n] / total1h).toFixed(1) + '%' }]));
      seg.addEventListener('pointerleave', hideTip);
      bar.append(seg);
      leg.append(h('span', null, swatch(color(n)), n, h('b', { text: num(ev1[n]) }), h('span', { class: 'hint', text: (100 * ev1[n] / total1h).toFixed(1) + '%' })));
    }
    mix.append(bar, leg);
  }

  // ---------- overview ----------
  const ovRange = rangeSeg('overview', () => loadOverview());
  async function loadOverview() {
    const d = await api('/api/series?range=' + ovRange());
    const series = foldSeries(d.events, d.ev, d.n);
    stacked($('ov-events'), d, series, d.n > 100 ? 'area' : 'bar', 'Events over time');
    legend($('ov-legend'), series);
    line($('ov-msgs'), d, d.mx.msgs, 'var(--s1)', num, 'Messages');
    line($('ov-busy'), d, d.mx.busy, 'var(--s1)', (v) => num(v, 2), 'Busy workers');
    line($('ov-ams'), d, d.mx.ams, 'var(--s1)', (v) => num(v, 0) + ' ms', 'Scan time');
    renderKpis();
  }

  // ---------- flow ----------
  const flRange = rangeSeg('flow', () => loadFlow());
  function fillEventSelect(sel, withAll) {
    const cur = sel.value;
    const names = Object.keys(slots).sort((a, b) => slots[a] - slots[b]);
    sel.replaceChildren();
    if (withAll) sel.append(h('option', { value: '', text: 'All events' }));
    for (const n of names) sel.append(h('option', { value: n, text: n }));
    if ([...sel.options].some((o) => o.value === cur)) sel.value = cur;
  }
  async function loadFlow() {
    const ev = $('fl-event').value, dim = $('fl-dim').value, win = $('fl-window').value;
    const [d, top] = await Promise.all([
      api('/api/series?range=' + flRange()),
      api('/api/top?dim=' + encodeURIComponent(dim) + '&window=' + win + '&n=25&event=' + encodeURIComponent(ev)),
    ]);
    let series;
    if (ev) series = d.ev[ev] ? [{ name: ev, color: color(ev), data: d.ev[ev] }] : [];
    else series = foldSeries(d.events, d.ev, d.n);
    $('fl-chart-title').textContent = ev ? 'Event: ' + ev : 'All events';
    stacked($('fl-chart'), d, series, 'bar', 'Events over time');
    legend($('fl-legend'), series);

    const dimName = $('fl-dim').selectedOptions[0].textContent;
    $('fl-top-title').textContent = 'Top ' + dimName.toLowerCase() + (ev ? ' for ' + ev : '') + ', ' + (win === '1h' ? 'last hour' : 'last 24 hours');
    const box = $('fl-top');
    box.replaceChildren();
    if (!top.items.length) { box.append(h('p', { class: 'hint', text: 'Nothing to show for this selection.' })); return; }
    const max = top.items[0].count;
    const list = h('div', { class: 'top-list', role: 'list' });
    for (const it of top.items) {
      const bar = h('i', { class: 'bar' });
      bar.style.width = (100 * it.count / max) + '%';
      bar.style.background = ev ? color(ev) : 'var(--s1)';
      list.append(h('div', {
        class: 'top-row', role: 'listitem', tabindex: '0', title: it.key,
        onclick: () => { goLive(it.key, ev); },
        onkeydown: (e) => { if (e.key === 'Enter') goLive(it.key, ev); },
      }, h('div', { class: 'top-k' }, bar, h('span', { text: it.key })), h('div', { class: 'top-c', text: num(it.count) })));
    }
    box.append(list);
  }
  function goLive(q, ev) {
    $('lv-q').value = q;
    S.evFilter = new Set(ev ? [ev] : []);
    location.hash = '#live';
  }

  // ---------- live ----------
  function evRow(e, isNew) {
    const tr = h('tr', { class: isNew ? 'new' : null, tabindex: '0' },
      h('td', { text: tclock(e.t) }),
      h('td', null, h('span', { class: 'evt' }, swatch(color(e.event)), e.event)),
      h('td', { text: e.values[0] || '', title: e.values[0] || '' }),
      h('td', { text: e.values[1] || '', title: e.values[1] || '' }),
      h('td', { text: e.sender, title: e.sender }),
      h('td', { text: e.rcpt || (e.rcpts > 1 ? e.rcpts + ' recipients' : ''), title: e.rcpt }),
      h('td', { class: 'subj', text: e.subject }));
    tr.addEventListener('click', () => showMessage(e.id));
    tr.addEventListener('keydown', (k) => { if (k.key === 'Enter') showMessage(e.id); });
    return tr;
  }
  function matches(e) {
    if (S.evFilter.size && !S.evFilter.has(e.event)) return false;
    const q = $('lv-q').value.trim().toLowerCase();
    if (!q) return true;
    return [e.id, e.event, ...e.values, e.sender, e.rcpt, e.subject].join('\u0000').toLowerCase().includes(q);
  }
  function renderLive() {
    const body = $('lv-body');
    const rows = [];
    for (let i = S.events.length - 1; i >= 0 && rows.length < 500; i--) {
      if (matches(S.events[i])) rows.push(evRow(S.events[i], false));
    }
    body.replaceChildren(...rows);
    $('lv-empty').hidden = S.events.length > 0;
    $('lv-count').textContent = rows.length + ' shown · ' + S.events.length + ' buffered' + (S.paused ? ' · paused' : '');
    renderChips();
  }
  function renderChips() {
    const counts = {};
    for (const e of S.events) counts[e.event] = (counts[e.event] || 0) + 1;
    const box = $('lv-chips');
    box.replaceChildren();
    for (const n of Object.keys(counts).sort((a, b) => (slots[a] || 99) - (slots[b] || 99))) {
      box.append(h('button', {
        class: 'chip', type: 'button', 'aria-pressed': S.evFilter.has(n) ? 'true' : 'false',
        onclick: () => { S.evFilter.has(n) ? S.evFilter.delete(n) : S.evFilter.add(n); renderLive(); },
      }, swatch(color(n)), n, h('b', { text: num(counts[n]) })));
    }
  }
  function addLive(list) {
    for (const e of list) S.events.push(e);
    if (S.events.length > MAXLIVE) S.events.splice(0, S.events.length - MAXLIVE);
    if (S.view !== 'live' || S.paused) { if (S.view === 'live') $('lv-count').textContent = S.events.length + ' buffered · paused'; return; }
    const body = $('lv-body');
    for (const e of list) if (matches(e)) body.prepend(evRow(e, true));
    while (body.children.length > 500) body.lastChild.remove();
    $('lv-empty').hidden = true;
    $('lv-count').textContent = body.children.length + ' shown · ' + S.events.length + ' buffered';
  }
  async function showMessage(id) {
    const p = $('lv-msg');
    const d = await api('/api/events?limit=200&id=' + encodeURIComponent(id));
    const tbl = h('table', { class: 'log' }, h('tbody', null, d.events.slice().reverse().map((e) => h('tr', null,
      h('td', { text: tclock(e.t) }), h('td', null, h('span', { class: 'evt' }, swatch(color(e.event)), e.event)),
      h('td', { text: e.values.filter((v) => v !== '').join(' · ') }), h('td', { text: e.rcpt || (e.rcpts > 1 ? e.rcpts + ' recipients' : '') })))));
    p.replaceChildren(h('button', { class: 'btn ghost', type: 'button', text: 'Close', onclick: () => { p.hidden = true; } }),
      h('h3', null, 'Message ', h('code', { text: id }), ' · ' + d.events.length + ' event(s)'),
      d.events[0] ? h('p', { class: 'hint', text: d.events[0].sender + (d.events[0].subject ? ' — ' + d.events[0].subject : '') }) : null,
      h('div', { class: 'tablewrap' }, tbl));
    p.hidden = false;
    p.scrollIntoView({ block: 'nearest' });
  }
  async function loadLive() {
    if (!S.events.length) {
      const d = await api('/api/events?limit=1000');
      S.events = d.events.slice().reverse();
    }
    renderLive();
  }

  // ---------- workers ----------
  async function loadWorkers() {
    const d = await api('/api/workers');
    const tiles = $('wk-tiles');
    if (!d.up) {
      tiles.replaceChildren();
      $('wk-groups').replaceChildren(h('p', { class: 'hint', text: 'Multiplexor not available' + (d.error ? ': ' + d.error : '.') }));
      return;
    }
    const ws = d.worker_states || {};
    tiles.replaceChildren(
      tile('Busy', num(ws.busy), '/ ' + ws.max),
      tile('Idle', num(ws.idle)),
      tile('Stopped', num(ws.stopped), null, 'min ' + (ws.min != null ? ws.min : '–')),
      tile('Killed', num(ws.killed)),
      tile('Messages', num(d.msgs), null, 'since start'),
      tile('Activations', num(d.activations), null, 'up ' + dur(d.uptime)),
    );
    const leg = $('wk-legend');
    // Stopped slots have no process: the tiles already count them
    const label = { busy: 'busy', idle: 'idle', killed: 'exiting' };
    leg.replaceChildren(...['busy', 'idle', 'killed'].map((st) => h('span', null, h('i', { class: 'dot ' + st }), label[st])));
    const card = (w) => h('div', { class: 'wk ' + w.state },
      h('div', { class: 'h' }, h('span', { text: '#' + w.id }), h('span', { class: 'st' }, h('i', { class: 'dot ' + w.state }), label[w.state] || w.state)),
      h('div', { class: 'tag', text: w.status_tag || (w.state === 'busy' ? 'working' : ''), title: w.status_tag || '' }),
      w.pid > 0 ? h('div', { class: 'm', text: 'pid ' + w.pid + ' · ' + num(w.scans) + ' scans · ' + num(w.requests) + ' req' }) : null,
      w.pid > 0 ? h('div', { class: 'm', text: 'age ' + dur(w.age) + ' · in state ' + dur(w.state_age) }) : null);
    const by = { busy: [], idle: [], killed: [] };
    for (const w of d.workers || []) if (by[w.state]) by[w.state].push(w);
    by.busy.sort((a, b) => (b.state_age || 0) - (a.state_age || 0) || a.id - b.id);
    by.idle.sort((a, b) => a.id - b.id);
    by.killed.sort((a, b) => a.id - b.id);
    const group = (title, list, empty) => h('div', { class: 'wk-group' },
      h('h3', null, title, h('span', { class: 'hint', text: num(list.length) })),
      list.length ? h('div', { class: 'workers' }, list.map(card)) : h('p', { class: 'hint', text: empty }));
    $('wk-groups').replaceChildren(
      group('Busy', by.busy, 'No busy workers'),
      group('Idle', by.idle, 'No idle workers'),
      ...(by.killed.length ? [group('Exiting', by.killed)] : []));

    const wins = [['0', '10 s'], ['1', '1 min'], ['5', '5 min'], ['10', '10 min']];
    const names = { scan: 'Scan', relayok: 'Relay', senderok: 'Sender', recipok: 'Recipient' };
    const lt = $('wk-load');
    lt.replaceChildren(h('thead', null, h('tr', null, h('th', { text: 'Requests / s' }), wins.map((w) => h('th', { text: w[1] })))),
      h('tbody', null, Object.keys(names).filter((k) => d.load && d.load[k]).flatMap((k) => [
        h('tr', null, h('td', { text: names[k] }), wins.map((w) => h('td', { text: num(d.load[k]['mps_' + w[0]], 2) }))),
        h('tr', null, h('td', { class: 'hint', text: '  avg ms' }), wins.map((w) => h('td', { class: 'hint', text: d.load[k]['msgs_' + w[0]] ? num(d.load[k]['ams_' + w[0]], 0) : '–' }))),
      ])));
    const ht = $('wk-hload');
    const hw = [['1', '1 h'], ['4', '4 h'], ['12', '12 h'], ['24', '24 h']];
    if (d.hload) {
      ht.replaceChildren(h('thead', null, h('tr', null, h('th', { text: 'Requests' }), hw.map((w) => h('th', { text: w[1] })))),
        h('tbody', null, Object.keys(names).filter((k) => d.hload[k]).map((k) =>
          h('tr', null, h('td', { text: names[k] }), hw.map((w) => h('td', { text: num(d.hload[k]['msgs_' + w[0]]) }))))));
    } else ht.replaceChildren();
    const histo = d.histo || [];
    if (histo.some((v) => v > 0)) bars($('wk-histo'), histo.map((_, i) => String(i + 1)), histo, 'var(--s1)', 'Requests', (i) => (i + 1) + ' busy worker' + (i ? 's' : ''));
    else noData($('wk-histo'), 'No requests handled yet');
    const as = $('wk-autoscale');
    as.replaceChildren();
    if (d.autoscale) {
      const a = d.autoscale;
      const kv = [['Autoscaling', a.enabled ? 'enabled' : 'disabled'], ['Busy ratio (EMA)', num(a.ema_busy, 2)], ['Scale out / in at', num(a.scale_out, 2) + ' / ' + num(a.scale_in, 2)], ['Cooldown out / in', a.out_cool + ' / ' + a.in_cool], ['Interval', a.interval + ' s']];
      for (const [k, v] of kv) as.append(h('dt', { text: k }), h('dd', { text: v }));
    }
  }

  // ---------- scores ----------
  const scRange = rangeSeg('scores', () => loadScores());
  const ML_LABELS = { ml_spam: 'Spam (ML)', ml_not_spam: 'Not spam (ML)', ml_phishing: 'Phishing (ML)', ml_not_phishing: 'Not phishing (ML)', ml_unsure: 'Uncertain (ML)' };
  const mlLabel = (e) => ML_LABELS[e] || e;
  async function loadScores() {
    const win = $('sc-window').value;
    const [d, ser] = await Promise.all([api('/api/scores?window=' + win), api('/api/series?range=' + scRange())]);
    const spam = d.scores[d.spam_event] || [];
    $('sc-spam-title').textContent = 'Spam score (' + d.spam_event + ' events)';
    if (spam.length) {
      const lo = Math.min(...spam.map((b) => b.bin)), hi = Math.max(...spam.map((b) => b.bin));
      const labels = [], vals = [];
      const byBin = Object.fromEntries(spam.map((b) => [b.bin, b.count]));
      for (let b = lo; b <= hi; b++) { labels.push(String(b)); vals.push(byBin[b] || 0); }
      bars($('sc-spam'), labels, vals, color(d.spam_event), 'Messages', (i) => 'Score ' + labels[i] + ' to ' + (Number(labels[i]) + 1));
    } else noData($('sc-spam'), 'No numeric scores for “' + d.spam_event + '”');

    const ml = $('sc-ml');
    ml.replaceChildren();
    for (const e of d.ml_events) {
      const bins = d.scores[e] || [];
      const box = h('div', { class: 'chart sm' });
      ml.append(h('div', { class: 'card' }, h('div', { class: 'card-h' }, h('h3', { text: mlLabel(e) + ' confidence' })), box));
      const labels = [], vals = [];
      const byBin = Object.fromEntries(bins.map((b) => [b.bin.toFixed(1), b.count]));
      for (let k = 0; k < 10; k++) { const key = (k / 10).toFixed(1); labels.push(key); vals.push(byBin[key] || 0); }
      if (bins.length) bars(box, labels, vals, color(e), 'Events', (i) => 'Confidence ' + labels[i] + '–' + ((i + 1) / 10).toFixed(1));
      else noData(box, 'No events');
    }
    const names = ser.events.filter((n) => d.ml_events.includes(n));
    const series = names.map((n) => ({ name: mlLabel(n), color: color(n), data: ser.ev[n] }));
    stacked($('sc-series'), ser, series, 'bar', 'ML verdicts over time');
    legend($('sc-legend'), series);
  }

  // ---------- router ----------
  const loaders = { overview: loadOverview, flow: loadFlow, live: loadLive, workers: loadWorkers, scores: loadScores };
  const titles = { overview: 'Overview', flow: 'Flow', live: 'Live log', workers: 'Workers', scores: 'Scores' };
  function route() {
    const v = (location.hash || '#overview').slice(1);
    S.view = loaders[v] ? v : 'overview';
    for (const sec of document.querySelectorAll('.view')) sec.hidden = sec.id !== 'v-' + S.view;
    for (const a of document.querySelectorAll('.nav a')) a.toggleAttribute('aria-current', a.dataset.view === S.view) && a.setAttribute('aria-current', 'page');
    $('title').textContent = titles[S.view];
    document.title = titles[S.view] + ' · MIMEDefang';
    if (S.view === 'flow') fillEventSelect($('fl-event'), true);
    refresh();
  }
  let refreshing = false;
  async function refresh() {
    if (refreshing) return;
    refreshing = true;
    try { await loaders[S.view](); } catch (e) { console.error(e); } finally { refreshing = false; }
  }

  // ---------- live connection ----------
  function connect() {
    const dot = $('live-dot');
    const es = new EventSource('/api/stream');
    es.addEventListener('open', () => { dot.className = 'live on'; dot.lastChild.textContent = 'live'; });
    es.addEventListener('error', () => { dot.className = 'live off'; dot.lastChild.textContent = 'reconnecting'; });
    es.addEventListener('tick', (m) => {
      const t = JSON.parse(m.data);
      if (S.summary) { t.events_1h = S.summary.events_1h; t.events_24h = S.summary.events_24h; }
      renderChrome(t);
      if (S.view === 'overview') renderKpis();
    });
    es.addEventListener('events', (m) => addLive(JSON.parse(m.data)));
  }

  async function loadSummary() {
    try { renderChrome(await api('/api/summary')); } catch (e) { console.error(e); }
  }

  // ---------- wiring ----------
  $('theme').addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    store('theme', root.dataset.theme);
  });
  const th = store('theme');
  if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;

  for (const id of ['fl-event', 'fl-dim', 'fl-window']) $(id).addEventListener('change', () => { store(id, $(id).value); loadFlow(); });
  for (const id of ['fl-dim', 'fl-window']) { const v = store(id); if (v) $(id).value = v; }
  $('sc-window').addEventListener('change', loadScores);
  let qt;
  $('lv-q').addEventListener('input', () => { clearTimeout(qt); qt = setTimeout(renderLive, 150); });
  $('lv-pause').addEventListener('click', (e) => {
    S.paused = !S.paused;
    e.currentTarget.setAttribute('aria-pressed', S.paused ? 'true' : 'false');
    e.currentTarget.textContent = S.paused ? 'Resume' : 'Pause';
    renderLive();
  });
  let rt;
  window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(refresh, 200); });
  window.addEventListener('hashchange', route);

  // Periodic refresh of the aggregated views; the live log is pushed.
  setInterval(() => { if (S.view !== 'live' && !document.hidden) refresh(); }, 10000);
  setInterval(() => { if (!document.hidden) loadSummary(); }, 30000);

  loadSummary().then(() => { route(); connect(); });
})();
