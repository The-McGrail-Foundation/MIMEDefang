[Unit]
Description=MIMEDefang live mail-flow dashboard
Documentation=man:mimedefang-dashboard(1)
After=network.target mimedefang-multiplexor.service

[Service]
Type=simple
Restart=on-failure
# Never run as root: the dashboard refuses to start as root.  The
# MIMEDefang user can read the multiplexor socket and create the feed
# socket in the spool directory.
User=defang
StateDirectory=MIMEDefang/dashboard
# DASHBOARD_* variables are documented in /etc/sysconfig/mimedefang.
# DASHBOARD_OPTIONS holds extra options.  To reach the dashboard from
# other hosts put a reverse proxy with TLS and authentication in front
# of it.
Environment=DASHBOARD_OPTIONS=
EnvironmentFile=-/etc/default/mimedefang
EnvironmentFile=-/etc/sysconfig/mimedefang
EnvironmentFile=-/etc/default/mimedefang-dashboard
EnvironmentFile=-/etc/sysconfig/mimedefang-dashboard
ExecStart=/bin/sh -c 'exec /usr/bin/mimedefang-dashboard \
    `[ -n "$DASHBOARD_STATE" ] && echo "--state $DASHBOARD_STATE"` \
    `[ -n "$DASHBOARD_LISTEN" ] && echo "--listen $DASHBOARD_LISTEN"` \
    `[ -n "$${DASHBOARD_MX_SOCKET:=$MX_SOCKET}" ] && echo "--mx-socket $DASHBOARD_MX_SOCKET"` \
    `[ -n "$DASHBOARD_FEED" ] && echo "--feed $DASHBOARD_FEED"` \
    `[ -n "$DASHBOARD_FEED_MODE" ] && echo "--feed-mode $DASHBOARD_FEED_MODE"` \
    `[ "$DASHBOARD_ANONYMIZE" = "yes" ] && echo "--anonymize"` \
    `for h in $DASHBOARD_ALLOW_HOST; do echo "--allow-host $h"; done` \
    $DASHBOARD_OPTIONS'
ExecReload=/bin/kill -HUP $MAINPID

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/spool/MIMEDefang

[Install]
WantedBy=multi-user.target
