use Mail::MIMEDefang::Authres;
use Mail::MIMEDefang::DKIM;
use Mail::MIMEDefang::LLM::Laya;
use Mail::MIMEDefang::Net qw(get_host_name);
use Mail::MIMEDefang::SPF;
use MIME::Words qw(decode_mimewords);

#***********************************************************************
# Set administrator's e-mail address here.
#***********************************************************************
$AdminAddress = 'postmaster@localhost';
$AdminName = "MIMEDefang Administrator's Full Name";

#***********************************************************************
# Set the envelope address that quarantine warnings appear to come from.
#***********************************************************************
$DaemonAddress = 'mimedefang@localhost';

$AddWarningsInline = 0;

#***********************************************************************
# Point this at your resident Laya server if it isn't on the default
# 127.0.0.1:8687, or tune the confidence threshold below which a
# verdict is treated as "no opinion".
#***********************************************************************
# $Mail::MIMEDefang::LLM::Laya::Config{server_url}     = 'http://127.0.0.1:8687';
# $Mail::MIMEDefang::LLM::Laya::Config{min_confidence} = 0.55;

md_graphdefang_log_enable('mail', 1);

# Set various stupid things your mail client does below.
$Stupidity{"NoMultipleInlines"} = 0;

detect_and_load_perl_modules();

#***********************************************************************
# filter_sender -- called when the MAIL FROM: envelope address arrives.
#
# Verifies SPF for the envelope sender and stashes the result for use
# once the From: header is available in filter_begin().
#***********************************************************************
sub filter_sender {
    my($sender, $ip, $hostname, $helo) = @_;

    (my $addr = $sender) =~ s/^<|>$//g;
    my ($domain) = ($addr =~ /\@([\w.\-]+)/);

    $Helo        = $helo;
    $SPFMailFrom = $addr;
    $SPFDomain   = $domain;
    $SPFResult   = undef;

    if (defined $domain && length $domain) {
        my ($spfcode, $spfexpl) = md_spf_verify($addr, $ip, $helo);
        if (defined $spfcode) {
            $SPFResult = $spfcode;
            md_syslog('info', "SPF result for $addr from $ip: $spfcode") unless $spfcode eq 'none';
        }
    }

    return ('CONTINUE', 'ok');
}

#***********************************************************************
# filter_begin -- called just before MIME parts are processed.
#
# Runs DKIM verification, DMARC lookup, and publishes an
# Authentication-Results header, so SPF/DKIM/DMARC results are all
# available for Laya's state by the time filter_end() runs.
#***********************************************************************
sub filter_begin {
    my($entity) = @_;

    if ($SuspiciousCharsInHeaders) {
        md_graphdefang_log('suspicious_chars');
        action_quarantine_entire_message("Message quarantined because of suspicious characters in headers");
        return action_discard();
    }

    my $from_header = $entity->head->get('From');
    my ($from_domain) = (defined $from_header ? ($from_header =~ /\@([\w.\-]+)/) : ());

    ($DKIMResult, $DKIMDomain) = md_dkim_verify();

    my $authres = md_authres($SPFMailFrom, $RelayAddr, get_host_name(), $Helo, $from_domain);
    if (defined $authres) {
        action_change_header("Authentication-Results", $authres);
    }

    $DMARCResult = 'unknown';
    if (defined $from_domain && length $from_domain) {
        my $dmarc_record = md_get_dmarc_record($from_domain);
        if (defined $dmarc_record) {
            my $policy = 'none';
            $policy = lc($1) if ($dmarc_record =~ /\bp=(\w+)/);

            my $from_org = Mail::MIMEDefang::Authres::md_org_domain($from_domain);
            my $aligned  = 0;
            $aligned = 1 if (defined $DKIMResult && $DKIMResult eq 'pass'
                              && defined $DKIMDomain && Mail::MIMEDefang::Authres::md_org_domain($DKIMDomain) eq $from_org);
            $aligned = 1 if (!$aligned && defined $SPFResult && $SPFResult eq 'pass'
                              && defined $SPFDomain && Mail::MIMEDefang::Authres::md_org_domain($SPFDomain) eq $from_org);

            $DMARCResult = $aligned ? 'pass' : $policy;
        }
    }

    return;
}

#***********************************************************************
# filter -- called once per MIME part.  No attachment policy here --
# this example is only about the Laya integration in filter_end().
#***********************************************************************
sub filter {
    my($entity, $fname, $ext, $type) = @_;

    return if message_rejected();

    return action_accept();
}

#***********************************************************************
# filter_end -- called after all MIME parts have been processed.
#
# Runs the usual SpamAssassin scoring, then feeds its result -- along
# with the message headers/body and the SPF/DKIM/DMARC results
# gathered above -- to Laya for a second, independent spam/phishing
# opinion.  Laya only acts on confident verdicts; anything else is
# left to SpamAssassin's own scoring.
#***********************************************************************
sub filter_end {
    my($entity) = @_;

    return if message_rejected();

    my ($hits, $req, $names, $report);
    if ($Features{"SpamAssassin"} && -s "./INPUTMSG" < 512*1024) {
        ($hits, $req, $names, $report) = spam_assassin_check();
        if (defined $hits) {
            my $stars = "*" x ($hits < 40 ? int($hits) : 40);
            if ($hits >= $req) {
                action_change_header("X-Spam-Score", "$hits ($stars) $names");
                md_graphdefang_log('spam', $hits, $RelayAddr);
                action_add_part($entity, "text/plain", "-suggest",
                    "$report\n", "SpamAssassinReport.txt", "inline");
            } else {
                action_delete_header("X-Spam-Score");
            }
        }
    }

    #*******************************************************************
    # Ask Laya for a second opinion, using the SpamAssassin score/rules
    # and auth results gathered above.  $Subject comes straight off the
    # wire and may still be RFC 2047 encoded (e.g. "=?utf-8?Q?...?=");
    # decode it first so Laya sees readable text, not encoded-word noise.
    #*******************************************************************
    my $subject = join('', map { $_->[0] // '' } decode_mimewords($Subject // ''));

    # do not pass SpamAssassin info to Laya, otherwise it would amplify SpamAssassin FPs
    my $state = laya_build_state(
        From    => $Sender,
        Subject => $subject,
        Body    => md_get_plain_text_body($entity),
        SAScore => undef, #$hits,
        SARules => undef, #[ defined $names ? split(/,/, $names) : () ],
        SPF     => $SPFResult,
        DKIM    => $DKIMResult,
        DMARC   => $DMARCResult,
    );

    my $verdict = laya_classify($state);

    if ($verdict->{error}) {
        md_syslog('info', "laya: no verdict ($verdict->{error}), falling back to SpamAssassin only");
        md_graphdefang_log('mail_in');
        return;
    }

    #*******************************************************************
    # The is_phishing threshold is set higher (0.90) than is_spam's
    # (0.80): with the multilingual checkpoint, legitimate bulk/ESP
    # marketing mail (tracking links, hidden preview-text padding,
    # occasional blacklisted redirect URLs) can trip is_phishing at
    # confidence >= 0.80, even at SpamAssassin scores well under its
    # own reject threshold.
    #*******************************************************************
    my $is_phishing_verdict = $verdict->{is_phishing}{answer}
        && $verdict->{is_phishing}{confidence} >= 0.90;
    my $is_spam_verdict = $verdict->{is_spam}{answer}
        && $verdict->{is_spam}{confidence} >= 0.80;

    if ($is_phishing_verdict) {
        md_syslog('info', sprintf('laya: phishing, confidence %.2f',
            $verdict->{is_phishing}{confidence}));
        md_graphdefang_log('laya_phishing', $verdict->{is_phishing}{confidence});
    }

    if ($is_spam_verdict) {
        md_syslog('info', sprintf('laya: spam, confidence %.2f -- tagging subject',
            $verdict->{is_spam}{confidence}));
        md_graphdefang_log('laya_spam', $verdict->{is_spam}{confidence});
        action_change_header('Subject', "[SPAM] $Subject");
    }

    #*******************************************************************
    # Expose Laya's opinion as a signed header, positive leans spam,
    # negative leans ham.
    #*******************************************************************
    if (defined $verdict->{is_spam}{answer}) {
        my $sign  = $verdict->{is_spam}{answer} ? 1 : -1;
        my $score = $sign * $verdict->{is_spam}{confidence};
        action_change_header('X-MIMEDefang-Laya-Score', sprintf('%.2f', $score));
    }

    #*******************************************************************
    # Spell out Laya's verdict in words too.
    #*******************************************************************
    my $laya_answer = 'undecided';
    if ($is_phishing_verdict) {
        $laya_answer = 'phishing';
    } elsif ($is_spam_verdict) {
        $laya_answer = 'spam';
    } elsif (defined $verdict->{is_spam}{answer} || defined $verdict->{is_phishing}{answer}) {
        $laya_answer = 'ham';
    }
    action_change_header('X-MIMEDefang-Laya-Answer', $laya_answer);

    md_graphdefang_log('mail_in');
}

